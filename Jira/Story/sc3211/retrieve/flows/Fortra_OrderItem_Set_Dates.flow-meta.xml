    <description>Updated End Date and Start Date Formula to refer OrderItem ServiceDate and EndDate</description>
    <environments>Default</environments>
    <formulas>
        <name>Tk</name>
        <dataType>Date</dataType>
        <expression>IF(OR(
	{!$Record.Product2.Rev_Category__c}=&quot;RC_41000&quot;,
	AND({!$Record.Product2.Product_Selling_Model_Type__c}=&quot;One Time&quot;,
		ISPICKVAL({!$Record.Product2.Family},&quot;Perpetual&quot;)),
	{!$Record.Order.MyCap__c}=TRUE),
{!$Record.ServiceDate},{!$Record.EndDate})</expression>
