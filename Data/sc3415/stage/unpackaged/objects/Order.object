<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Assetization_Status__c</fullName>
        <label>Assetization Status</label>
        <description>Outcome of the asynchronous RLM asset-generation step (Fortra - Assetize Order). Success or Failed. Surfaces failures that the async flow would otherwise swallow silently. SC-3415.</description>
        <type>Picklist</type>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Assetization_Error__c</fullName>
        <label>Assetization Error</label>
        <description>Fault message captured when asset generation fails on Order activation (e.g. optimistic-lock collision on duplicate same-product lines). Populated by Fortra - Assetize Order. SC-3415.</description>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>3</visibleLines>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
</CustomObject>
