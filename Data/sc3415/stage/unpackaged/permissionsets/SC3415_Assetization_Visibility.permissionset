<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SC3415 Assetization Visibility</label>
    <description>Read/edit on Order.Assetization_Status__c and Assetization_Error__c so failed asset generation is visible/reportable. SC-3415 (UAT).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <field>Order.Assetization_Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Order.Assetization_Error__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
