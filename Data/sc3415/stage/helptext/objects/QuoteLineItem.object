<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>PricingTermCount</fullName>
        <inlineHelpText>System-derived from the subscription term — you can't type this. To set the contract length, use Subscription Term (the count is derived from it). The order still activates if this is blank.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>SubscriptionTerm</fullName>
        <inlineHelpText>Sets the contract length (number of periods). Pricing Term Count is derived from this and the term unit — edit Subscription Term, not Pricing Term Count.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
</CustomObject>
