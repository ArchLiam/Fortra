    <description>FORTRA-PRODUCT-018 Maintenance (Derived) Pricing — stamps the pricing inputs the gated procedure formulas read. NEW business: stamps the source license line&apos;s pre-partner price (Pre_Partner_Price__c, else ListPrice, else UnitPrice) onto Base_Price__c so partner discounts do not corrupt the discount-immune base. RENEWAL: only derived maintenance lines (PriceBookEntryDerivedPrice gate); stamps the prior maintenance order line&apos;s Base + null-safe Partner$/Discretionary$ for the current Product2Id, with fallback to any prior order line with Base_Price__c &gt; 0 (RRM from prior RNM). Then resolves COLA rate (line override -&gt; category default). Also stamps QuoteLineItem.Fortra_Product_Type__c from Product2 when blank. Before-save, no DML, no recursion. OPEN ITEMS: (1) prior-OrderItem lookup is not account/asset-scoped; (2) COLA contract-override tier not resolved here; (3) COLA date-effectivity not filtered.</description>
    <environments>Default</environments>
    <formulas>
        <name>ComputedDiscretionary</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem.Prior_Discretionary_Discount__c}, 0) &gt; 0, {!Get_Prior_OrderItem.Prior_Discretionary_Discount__c}, IF(BLANKVALUE({!Get_Prior_OrderItem.Discount}, 0) &gt; 0, (BLANKVALUE({!Get_Prior_OrderItem.Base_Price__c}, 0) - {!NullSafePartner}) * {!Get_Prior_OrderItem.Discount} / 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ComputedDiscretionaryFallback</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Prior_Discretionary_Discount__c}, 0) &gt; 0, {!Get_Prior_OrderItem_Maint_Base.Prior_Discretionary_Discount__c}, IF(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Discount}, 0) &gt; 0, (BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Base_Price__c}, 0) - {!NullSafePartnerFallback}) * {!Get_Prior_OrderItem_Maint_Base.Discount} / 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ComputedRenewalColaNet</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!$Record.Base_Price__c}, 0) &gt; 0, (BLANKVALUE({!$Record.Base_Price__c}, 0) - BLANKVALUE({!$Record.Prior_Partner_Discount__c}, 0) - BLANKVALUE({!$Record.Prior_Discretionary_Discount__c}, 0)) * (1 + (BLANKVALUE({!$Record.COLA_Uplift_Percent__c}, 0) / 100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NullSafePartner</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem.Prior_Partner_Discount__c}, 0) &gt; 0, {!Get_Prior_OrderItem.Prior_Partner_Discount__c}, IF(AND(BLANKVALUE({!Get_Prior_OrderItem.PartnerDiscountPercent}, 0) &gt; 0, BLANKVALUE({!Get_Prior_OrderItem.Base_Price__c}, 0) &gt; 0), BLANKVALUE({!Get_Prior_OrderItem.Base_Price__c}, 0) * BLANKVALUE({!Get_Prior_OrderItem.PartnerDiscountPercent}, 0) / 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NullSafePartnerFallback</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Prior_Partner_Discount__c}, 0) &gt; 0, {!Get_Prior_OrderItem_Maint_Base.Prior_Partner_Discount__c}, IF(AND(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.PartnerDiscountPercent}, 0) &gt; 0, BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Base_Price__c}, 0) &gt; 0), BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Base_Price__c}, 0) * BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.PartnerDiscountPercent}, 0) / 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriorPartnerPercent</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem.PartnerDiscountPercent}, 0) &gt; 0, {!Get_Prior_OrderItem.PartnerDiscountPercent}, IF(BLANKVALUE({!Get_Prior_OrderItem.Base_Price__c}, 0) &gt; 0, BLANKVALUE({!Get_Prior_OrderItem.Prior_Partner_Discount__c}, 0) / {!Get_Prior_OrderItem.Base_Price__c} * 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriorPartnerPercentFallback</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.PartnerDiscountPercent}, 0) &gt; 0, {!Get_Prior_OrderItem_Maint_Base.PartnerDiscountPercent}, IF(BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Base_Price__c}, 0) &gt; 0, BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Prior_Partner_Discount__c}, 0) / {!Get_Prior_OrderItem_Maint_Base.Base_Price__c} * 100, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriorSoftwareDiscountPercent</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Prior_OrderItem.Discount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriorSoftwareDiscountPercentFallback</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Prior_OrderItem_Maint_Base.Discount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ResolvedLicenseSourceBase</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Source_Line.Pre_Partner_Price__c})), {!Get_Source_Line.Pre_Partner_Price__c}, IF(NOT(ISBLANK({!Get_Source_Line.ListPrice})), {!Get_Source_Line.ListPrice}, {!Get_Source_Line.UnitPrice}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ResolvedRenewalContractId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.Renewal_Contract__c}), {!Get_Quote.ContractId}, {!Get_Quote.Renewal_Contract__c})</expression>
    </formulas>
