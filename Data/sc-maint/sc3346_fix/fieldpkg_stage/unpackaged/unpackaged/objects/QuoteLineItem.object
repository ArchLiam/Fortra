<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>COLA_Outyear_Uplift_Percent__c</fullName>
        <description>The COLA uplift percentage applied to out-years (years 2+) on multi-year deals. Defaults to MyCAP_Rules__mdt Global value when COLA Source is MyCAP Default. Editable for negotiated out-year rates.</description>
        <externalId>false</externalId>
        <inlineHelpText>The COLA percentage applied to out-years (years 2+). Defaults to the MyCAP rate but can be overridden for negotiated deals.</inlineHelpText>
        <label>COLA Outyear Uplift Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Final_Year_COLA_Calculated_Price__c</fullName>
        <description>Compounded COLA price for the final year of a multi-year deal. Derives the annual COLA rate from COLACalculatedPrice__c / Pre_COLA_Price__c and compounds across PricingTermCount years. For single-year deals, equals COLACalculatedPrice__c.</description>
        <formula>IF(
  AND(
    PricingTermCount &gt; 1,
    COLACalculatedPrice__c &gt; 0,
    COLA_Outyear_Uplift_Percent__c &gt; 0
  ),
  ROUND(
    COLACalculatedPrice__c * EXP(
      LN(1 + COLA_Outyear_Uplift_Percent__c / 100)
      * (PricingTermCount - 1)
    ),
    2
  ),
  IF(
    AND(
      PricingTermCount &gt; 1,
      COLA_Uplift_Percent__c &gt; 0,
      Pre_COLA_Price__c &gt; 0
    ),
    ROUND(
      Pre_COLA_Price__c * EXP(LN(1 + COLA_Uplift_Percent__c / 100) * PricingTermCount),
      2
    ),
    COLACalculatedPrice__c
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The compounded COLA-adjusted price for the final year of a multi-year subscription. For single-year deals, this equals the COLA Calculated Price.</inlineHelpText>
        <label>Final Year COLA Calculated Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Prior_Discretionary_Discount__c</fullName>
        <description>Maintenance (derived) pricing: the discretionary (software) discount on this maintenance line expressed as a DOLLAR amount. On a renewal line it holds the prior period&apos;s discretionary discount (carried forward from the originating order line) before the COLA uplift the renewal formula applies. FORTRA-PRODUCT-018.</description>
        <inlineHelpText>Discretionary discount on the maintenance line in dollars; on renewals, the prior-period value carried forward (pre-COLA).</inlineHelpText>
        <label>Prior Discretionary Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Prior_Partner_Discount__c</fullName>
        <description>Maintenance (derived) pricing: the partner discount on this maintenance line expressed as a DOLLAR amount. On a renewal line it holds the prior period&apos;s partner discount (carried forward from the originating order line) before the COLA uplift the renewal formula applies. FORTRA-PRODUCT-018.</description>
        <inlineHelpText>Partner discount on the maintenance line in dollars; on renewals, the prior-period value carried forward (pre-COLA).</inlineHelpText>
        <label>Prior Partner Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Source_List_Price__c</fullName>
        <description>Source license list price stamped by Flow for derived maintenance line pricing. Read by Rev_Mgmt Derived Pricing Formula.</description>
        <inlineHelpText>List price of the contributing license product, stamped automatically for maintenance/support lines.</inlineHelpText>
        <label>Source List Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
</CustomObject>
