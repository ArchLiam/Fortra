Execute Anonymous: // SMOKE TEST — QuoteLineItem trigger merge (SC3346). Real UAT catalog data, savepoint→rollback (zero residue).
Execute Anonymous: Savepoint sp = Database.setSavepoint();
Execute Anonymous: List<String> log = new List<String>();
Execute Anonymous: Id HW_ID = 'a0nWC000001R0eTYAS';
Execute Anonymous: try {
Execute Anonymous:     Id pb = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous:     PricebookEntry usdPbe = [SELECT Id, Product2Id FROM PricebookEntry
Execute Anonymous:         WHERE Pricebook2Id = :pb AND CurrencyIsoCode = 'USD' AND IsActive = true AND Product2Id IN (SELECT Product2Id FROM ProductSellingModelOption WHERE ProductSellingModel.SellingModelType = 'OneTime') LIMIT 1];
Execute Anonymous:     PricebookEntry eurPbe = [SELECT Id, Product2Id FROM PricebookEntry
Execute Anonymous:         WHERE Pricebook2Id = :pb AND CurrencyIsoCode = 'EUR' AND IsActive = true AND Product2Id IN (SELECT Product2Id FROM ProductSellingModelOption WHERE ProductSellingModel.SellingModelType = 'OneTime') LIMIT 1];
Execute Anonymous: 
Execute Anonymous:     Account a = new Account(Name = 'SMOKE SC3346 QLI merge'); insert a;
Execute Anonymous: 
Execute Anonymous:     // ===================== USD opp/quote: hardware linking + FX(USD) + re-link + propagation =====================
Execute Anonymous:     Opportunity usdOpp = new Opportunity(Name = 'SMOKE USD Opp', AccountId = a.Id,
Execute Anonymous:         StageName = 'Prospecting', CloseDate = Date.today().addDays(30)); insert usdOpp;
Execute Anonymous:     Quote usdQ = new Quote(Name = 'SMOKE USD Quote', OpportunityId = usdOpp.Id, Pricebook2Id = pb); insert usdQ;
Execute Anonymous:     QuoteLineGroup grp = new QuoteLineGroup(Name = 'SMOKE HW Group', QuoteId = usdQ.Id,
Execute Anonymous:         Hardware__c = HW_ID, Hardware_Group_Type__c = true); insert grp;
Execute Anonymous: 
Execute Anonymous:     // T1/T2: bulk 20 USD lines, first 10 in the hardware group
Execute Anonymous:     List<QuoteLineItem> usdLines = new List<QuoteLineItem>();
Execute Anonymous:     for (Integer i = 0; i < 20; i++) {
Execute Anonymous:         usdLines.add(new QuoteLineItem(QuoteId = usdQ.Id, Product2Id = usdPbe.Product2Id,
Execute Anonymous:             PricebookEntryId = usdPbe.Id, Quantity = 1, UnitPrice = 100,
Execute Anonymous:             QuoteLineGroupId = (i < 10 ? grp.Id : null)));
Execute Anonymous:     }
Execute Anonymous:     insert usdLines;
Execute Anonymous:     Integer rate1 = 0, hwSet = 0, hwNull = 0;
Execute Anonymous:     for (QuoteLineItem q : [SELECT Exchange_Rate_To_USD__c, Hardware__c, QuoteLineGroupId
Execute Anonymous:                             FROM QuoteLineItem WHERE Id IN :usdLines]) {
Execute Anonymous:         if (q.Exchange_Rate_To_USD__c == 1.0) rate1++;
Execute Anonymous:         if (q.QuoteLineGroupId != null && q.Hardware__c == HW_ID) hwSet++;
Execute Anonymous:         if (q.QuoteLineGroupId == null && q.Hardware__c == null) hwNull++;
Execute Anonymous:     }
Execute Anonymous:     log.add('T1 FX-stamp USD=1.0 (bulk 20): ' + rate1 + '/20 ' + (rate1 == 20 ? 'PASS' : 'FAIL'));
Execute Anonymous:     log.add('T2 hardware linked (grouped 10): ' + hwSet + '/10 ' + (hwSet == 10 ? 'PASS' : 'FAIL'));
Execute Anonymous:     log.add('T2b hardware null (ungrouped 10): ' + hwNull + '/10 ' + (hwNull == 10 ? 'PASS' : 'FAIL'));
Execute Anonymous: 
Execute Anonymous:     // T3: before-update re-link — move an ungrouped line into the hardware group
Execute Anonymous:     QuoteLineItem mover = [SELECT Id FROM QuoteLineItem WHERE Id IN :usdLines AND QuoteLineGroupId = null LIMIT 1];
Execute Anonymous:     mover.QuoteLineGroupId = grp.Id; update mover;
Execute Anonymous:     QuoteLineItem moved = [SELECT Hardware__c FROM QuoteLineItem WHERE Id = :mover.Id];
Execute Anonymous:     log.add('T3 before-update re-link: ' + (moved.Hardware__c == HW_ID ? 'PASS' : 'FAIL'));
Execute Anonymous: 
Execute Anonymous:     // T5-USD: propagation to synced opp (USD => 1.0)
Execute Anonymous:     update new Opportunity(Id = usdOpp.Id, SyncedQuoteId = usdQ.Id);
Execute Anonymous:     insert new QuoteLineItem(QuoteId = usdQ.Id, Product2Id = usdPbe.Product2Id,
Execute Anonymous:         PricebookEntryId = usdPbe.Id, Quantity = 1, UnitPrice = 50);
Execute Anonymous:     Opportunity usdOppAfter = [SELECT Exchange_Rate_To_USD__c FROM Opportunity WHERE Id = :usdOpp.Id];
Execute Anonymous:     log.add('T5 USD propagation to synced opp: opp.rate=' + usdOppAfter.Exchange_Rate_To_USD__c
Execute Anonymous:         + ' ' + (usdOppAfter.Exchange_Rate_To_USD__c == 1.0 ? 'PASS' : 'FAIL'));
Execute Anonymous: 
Execute Anonymous:     // ===================== EUR opp/quote: FX(EUR) stamp == lookup + EUR propagation =====================
Execute Anonymous:     Opportunity eurOpp = new Opportunity(Name = 'SMOKE EUR Opp', AccountId = a.Id,
Execute Anonymous:         StageName = 'Prospecting', CloseDate = Date.today().addDays(30), CurrencyIsoCode = 'EUR'); insert eurOpp;
Execute Anonymous:     Quote eurQ = new Quote(Name = 'SMOKE EUR Quote', OpportunityId = eurOpp.Id, Pricebook2Id = pb,
Execute Anonymous:         CurrencyIsoCode = 'EUR'); insert eurQ;
Execute Anonymous: 
Execute Anonymous:     DatedConversionRateLookup.Request rq = new DatedConversionRateLookup.Request(); rq.currencyIsoCode = 'EUR';
Execute Anonymous:     Decimal expectedEur = DatedConversionRateLookup.getExchangeRates(
Execute Anonymous:         new List<DatedConversionRateLookup.Request>{ rq })[0].exchangeRate;
Execute Anonymous: 
Execute Anonymous:     QuoteLineItem eurLine = new QuoteLineItem(QuoteId = eurQ.Id, Product2Id = eurPbe.Product2Id,
Execute Anonymous:         PricebookEntryId = eurPbe.Id, Quantity = 1, UnitPrice = 100); insert eurLine;
Execute Anonymous:     QuoteLineItem eurReloaded = [SELECT Exchange_Rate_To_USD__c, CurrencyIsoCode
Execute Anonymous:         FROM QuoteLineItem WHERE Id = :eurLine.Id];
Execute Anonymous:     log.add('T4 FX-stamp EUR (cur=' + eurReloaded.CurrencyIsoCode + '): got='
Execute Anonymous:         + eurReloaded.Exchange_Rate_To_USD__c + ' lookup=' + expectedEur + ' '
Execute Anonymous:         + (eurReloaded.Exchange_Rate_To_USD__c == expectedEur && expectedEur != null ? 'PASS' : 'FAIL'));
Execute Anonymous: 
Execute Anonymous:     // T6: EUR propagation — opp rate becomes the EUR rate (distinct from USD 1.0), proving the copy
Execute Anonymous:     update new Opportunity(Id = eurOpp.Id, SyncedQuoteId = eurQ.Id);
Execute Anonymous:     insert new QuoteLineItem(QuoteId = eurQ.Id, Product2Id = eurPbe.Product2Id,
Execute Anonymous:         PricebookEntryId = eurPbe.Id, Quantity = 1, UnitPrice = 55);
Execute Anonymous:     Opportunity eurOppAfter = [SELECT Exchange_Rate_To_USD__c FROM Opportunity WHERE Id = :eurOpp.Id];
Execute Anonymous:     log.add('T6 EUR propagation to synced opp: opp.rate=' + eurOppAfter.Exchange_Rate_To_USD__c
Execute Anonymous:         + ' expected=' + expectedEur + ' '
Execute Anonymous:         + (eurOppAfter.Exchange_Rate_To_USD__c == expectedEur ? 'PASS' : 'FAIL'));
Execute Anonymous: 
Execute Anonymous:     log.add('RESULT: all merged paths executed with NO exception');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     log.add('EXCEPTION ' + e.getTypeName() + ': ' + e.getMessage());
