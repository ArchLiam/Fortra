67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // LEAN EUR smoke — before-UPDATE FX re-stamp (where CurrencyIsoCode is populated). Savepoint→rollback.
Execute Anonymous: Savepoint sp = Database.setSavepoint();
Execute Anonymous: List<String> log = new List<String>();
Execute Anonymous: try {
Execute Anonymous:     Id pb = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous:     PricebookEntry eurPbe = [SELECT Id, Product2Id FROM PricebookEntry
Execute Anonymous:         WHERE Pricebook2Id = :pb AND CurrencyIsoCode = 'EUR' AND IsActive = true
Execute Anonymous:         AND Product2Id IN (SELECT Product2Id FROM ProductSellingModelOption
Execute Anonymous:                            WHERE ProductSellingModel.SellingModelType = 'OneTime') LIMIT 1];
Execute Anonymous: 
Execute Anonymous:     Account a = new Account(Name = 'SMOKE EUR'); insert a;
Execute Anonymous:     Opportunity o = new Opportunity(Name = 'SMOKE EUR Opp', AccountId = a.Id,
Execute Anonymous:         StageName = 'Prospecting', CloseDate = Date.today().addDays(30), CurrencyIsoCode = 'EUR'); insert o;
Execute Anonymous:     Quote q = new Quote(Name = 'SMOKE EUR Q', OpportunityId = o.Id, Pricebook2Id = pb,
Execute Anonymous:         CurrencyIsoCode = 'EUR'); insert q;
Execute Anonymous: 
Execute Anonymous:     QuoteLineItem line = new QuoteLineItem(QuoteId = q.Id, Product2Id = eurPbe.Product2Id,
Execute Anonymous:         PricebookEntryId = eurPbe.Id, Quantity = 1, UnitPrice = 100); insert line;
Execute Anonymous:     QuoteLineItem afterInsert = [SELECT CurrencyIsoCode, Exchange_Rate_To_USD__c FROM QuoteLineItem WHERE Id = :line.Id];
Execute Anonymous:     log.add('EUR after-insert: cur=' + afterInsert.CurrencyIsoCode + ' rate=' + afterInsert.Exchange_Rate_To_USD__c);
Execute Anonymous: 
Execute Anonymous:     // Now CurrencyIsoCode is EUR — a before-UPDATE re-stamps with the EUR rate.
Execute Anonymous:     update new QuoteLineItem(Id = line.Id, Quantity = 2);
Execute Anonymous:     QuoteLineItem afterUpdate = [SELECT CurrencyIsoCode, Exchange_Rate_To_USD__c FROM QuoteLineItem WHERE Id = :line.Id];
Execute Anonymous: 
Execute Anonymous:     DatedConversionRateLookup.Request rq = new DatedConversionRateLookup.Request(); rq.currencyIsoCode = 'EUR';
Execute Anonymous:     Decimal expectedEur = DatedConversionRateLookup.getExchangeRates(
Execute Anonymous:         new List<DatedConversionRateLookup.Request>{ rq })[0].exchangeRate;
Execute Anonymous: 
Execute Anonymous:     log.add('EUR after-update: cur=' + afterUpdate.CurrencyIsoCode + ' rate=' + afterUpdate.Exchange_Rate_To_USD__c
Execute Anonymous:         + ' lookup=' + expectedEur + ' '
Execute Anonymous:         + (afterUpdate.Exchange_Rate_To_USD__c == expectedEur && expectedEur != null ? 'PASS' : 'FAIL'));
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     log.add('EXCEPTION ' + e.getTypeName() + ': ' + e.getMessage());
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }
Execute Anonymous: for (String s : log) System.debug('SMOKE| ' + s);
