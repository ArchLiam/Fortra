<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Partner_Pricing_Source__c</fullName>
        <description>Indicates how the partner pricing was set: System Calculated or Manual Override.</description>
        <externalId>false</externalId>
        <inlineHelpText>How was this partner price determined?</inlineHelpText>
        <label>Partner Pricing Source</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pre_Partner_Price__c</fullName>
        <description>The unit price before partner pricing adjustments. Captures the price after Regional Pricing has been applied.</description>
        <inlineHelpText>Original price before partner adjustments were applied.</inlineHelpText>
        <label>Pre-Partner Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <type>Currency</type>
    </fields>
</CustomObject>
