    <decisions>
        <name>Check_Pricing_Term_Unit</name>
        <label>Check Pricing Term Unit</label>
        <locationX>578</locationX>
        <locationY>719</locationY>
        <defaultConnector>
            <targetReference>Set_ARR_to_Zero</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unknown Term Unit</defaultConnectorLabel>
        <rules>
            <name>Is_Annual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model.PricingTermUnit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Annual</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NARR_Annual</targetReference>
            </connector>
            <label>Annual</label>
        </rules>
        <rules>
            <name>Is_Semi_Annual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model.PricingTermUnit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Semi-Annual</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NARR_Semi_Annual</targetReference>
            </connector>
            <label>Semi-Annual</label>
        </rules>
        <rules>
            <name>Is_Quarterly</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model.PricingTermUnit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quarterly</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NARR_Quarterly</targetReference>
            </connector>
            <label>Quarterly</label>
        </rules>
        <rules>
            <name>Is_Monthly</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model.PricingTermUnit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Months</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NARR_Monthly</targetReference>
            </connector>
            <label>Monthly</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Selling_Model_Type</name>
        <label>Check Selling Model Type</label>
        <locationX>226</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>Check_Pricing_Term_Unit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Term-Based Product</defaultConnectorLabel>
        <rules>
            <name>Is_One_Time_Product</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OneTime</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Product_Selling_Model</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_ARR_to_Zero</targetReference>
            </connector>
            <label>Is One-Time or No Selling Model</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Product_a_New_Maintenance_or_Subscription_NOT_a_Renewal</name>
        <label>Is Product a New Maintenance or Subscription &amp; NOT a Renewal?</label>
        <locationX>754</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fortra_Product_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Maintenance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Fortra_Product_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Subscription</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote.Quote_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Product_Selling_Model</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Excluded_from_Business_Logic</name>
        <label>User Excluded from Business Logic</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Is_Product_a_New_Maintenance_or_Subscription_NOT_a_Renewal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_User_Excluded_from_Business_Logic</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Data_Migration_Exclude_Business_Logic</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Calculates Annual Recurring Revenue (ARR) on Quote Line Items based on TotalLineAmount, PricingTermCount, and the Product Selling Model configuration. Handles different PricingTermUnit values (Annual, Semi-Annual, Quarterly, Months) and excludes One-Time products.</description>
    <environments>Default</environments>
    <formulas>
        <name>assign_baseNARR_Annual</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,
        {!$Record.TotalLineAmount} / {!$Record.PricingTermCount}
    )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>assign_baseNARR_Monthly</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 12)
    )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>assign_baseNARR_Quarterly</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 4)
    )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>assign_baseNARR_SemiAnnual</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 2)
    )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_ARR_Annual</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,
    IF(NOT(ISNULL({!$Record.Displaced_ARR_Input__c})),
        ({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) - {!$Record.Displaced_ARR_Input__c},
        {!$Record.TotalLineAmount} / {!$Record.PricingTermCount}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_ARR_Monthly</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,

    IF(NOT(ISNULL({!$Record.Displaced_ARR_Input__c})),
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 12) - {!$Record.Displaced_ARR_Input__c},
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 12)
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_ARR_Quarterly</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,

    IF(NOT(ISNULL({!$Record.Displaced_ARR_Input__c})),
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 4) - {!$Record.Displaced_ARR_Input__c},
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 4)
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_ARR_Semi_Annual</name>
        <dataType>Currency</dataType>
        <expression>IF(
    OR(
        ISNULL({!$Record.PricingTermCount}),
        {!$Record.PricingTermCount} = 0,
        ISNULL({!$Record.TotalLineAmount})
    ),
    0,

    IF(NOT(ISNULL({!$Record.Displaced_ARR_Input__c})),
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 2)  - {!$Record.Displaced_ARR_Input__c},
        (({!$Record.TotalLineAmount} / {!$Record.PricingTermCount}) * 2)
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Calculate Quote Line ARR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | QuoteLineItem | Before Insert/Update - Calculate ARR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Product_Selling_Model</name>
        <label>Get Product Selling Model</label>
        <locationX>226</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Selling_Model_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ProductSellingModelId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ProductSellingModel</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>User_Excluded_from_Business_Logic</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProductSellingModelId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
