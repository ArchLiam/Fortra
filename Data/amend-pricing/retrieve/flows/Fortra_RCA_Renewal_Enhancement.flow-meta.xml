    <description>Record-Triggered Flow on Quote (After Save) that enhances RCA renewal and amendment Quotes with Fortra-specific fields. Traces Asset origin via the AssetAction (CategoryEnum=Initial Sale) -&gt; AssetActionSource -&gt; OrderItem lineage to the originating Order/Contract on the asset&apos;s own account (not a global product match). Creates a Renewal/Amendment/Cancellation Opportunity with Deal_Origin__c, copies billing address, places, Net Terms, Language, Deal Origin, and contact fields from original Quote. Handles Renew, Amend, No Change, and Cancel QuoteAction types. Sets Quote_Type__c, creates Opportunity, and populates Fortra-specific fields.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_ActiveLegalEntityId</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_Active_Contract.Legal_Entity__r.Status}) = &quot;Active&quot;, {!Get_Active_Contract.Legal_Entity__c}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_BillingCity</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingCity}), {!Get_Account.BillingCity}, {!Get_Original_Quote.BillingCity})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingCountry</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingCountry}), {!Get_Account.BillingCountry}, {!Get_Original_Quote.BillingCountry})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingPostalCode</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingPostalCode}), {!Get_Account.BillingPostalCode}, {!Get_Original_Quote.BillingPostalCode})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingState</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingState}), {!Get_Account.BillingState}, {!Get_Original_Quote.BillingState})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingStreet</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingStreet}), {!Get_Account.BillingStreet}, {!Get_Original_Quote.BillingStreet})</expression>
    </formulas>
    <formulas>
        <name>formula_CloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Active_Contract.EndDate}), TODAY() + 90, {!Get_Active_Contract.EndDate})</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityName</name>
        <dataType>String</dataType>
        <expression>{!formula_QuoteType} &amp; &quot; - &quot; &amp; {!Get_Account.Name} &amp; &quot; - &quot; &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>formula_QuoteType</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_QuoteAction.Type}) = &quot;Renew&quot;, &quot;Renewal&quot;, IF(TEXT({!Get_QuoteAction.Type}) = &quot;Cancel&quot;, &quot;Cancellation&quot;, &quot;Amendment&quot;))</expression>
    </formulas>
    <formulas>
        <name>formula_TransformedDealOrigin</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!Get_Original_Opportunity.Deal_Origin__c})),
    &quot;&quot;,
    IF(
        TEXT({!Get_Original_Opportunity.Deal_Origin__c}) = &quot;Fortra Originated&quot;,
        &quot;Fortra Originated&quot;,
        &quot;Channel Originated&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TransformedDealType</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!Get_Original_Quote.Deal_Type__c})),
    &quot;&quot;,
    IF(
        TEXT({!Get_Original_Quote.Deal_Type__c}) = &quot;Fortra Originated&quot;,
        &quot;Fortra Originated&quot;,
        &quot;Channel Originated&quot;
    )
)</expression>
    </formulas>
