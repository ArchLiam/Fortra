                                    <operator>EQUAL</operator>
                                    <rightValue>Tech</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Qualified</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Convert_to_Opportunity_Custom}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
