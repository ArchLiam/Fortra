        <rules>
            <name>Unlimited_Classification_Pattern</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Unlimited Classification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Product_Identifier_UC</targetReference>
            </connector>
            <label>Unlimited Classification Pattern</label>
        </rules>
        <rules>
            <name>Professional_Services_Pattern</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Professional Services</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Product_Identifier_Professional_Services</targetReference>
            </connector>
            <label>Professional Services Pattern</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Type_Abbreviation</name>
        <label>Determine Type Abbreviation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_TypeAbbr_OTH</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Bundle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
