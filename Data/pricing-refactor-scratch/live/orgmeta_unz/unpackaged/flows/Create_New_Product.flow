    <decisions>
        <name>Determine_Catalog_from_Category</name>
        <label>Determine Catalog from Category</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_CatalogAbbr_GEN_Generic</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Cyber_Catalog</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CategoryRecordId.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cyber</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CategoryRecordId.ProductCategory.ParentCategory.ParentCategory.ParentCategory.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cyber</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_CatalogAbbr_CYB</targetReference>
            </connector>
            <label>Cyber Catalog</label>
        </rules>
        <rules>
            <name>Infrastructure_Catalog</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CategoryRecordId.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Infrastructure</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CategoryRecordId.ProductCategory.ParentCategory.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Infrastructure</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_CatalogAbbr_INF</targetReference>
            </connector>
            <label>Infrastructure Catalog</label>
        </rules>
        <rules>
            <name>IAM_Catalog</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CategoryRecordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Identity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CategoryRecordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Access Management</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_CatalogAbbr_IAM</targetReference>
            </connector>
            <label>IAM Catalog</label>
        </rules>
        <rules>
            <name>Network_Catalog</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CategoryRecordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Network</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_CatalogAbbr_NET</targetReference>
            </connector>
            <label>Network Catalog</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Family_Abbreviation</name>
        <label>Determine Family Abbreviation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_FamilyAbbr_to_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Data_Protection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Family</leftValueReference>
                <operator>EqualTo</operator>
