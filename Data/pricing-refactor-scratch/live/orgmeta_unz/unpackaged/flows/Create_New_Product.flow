            <conditions>
                <leftValueReference>recordId.Family</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vulnerability Management</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_FamilyAbbr_VM</targetReference>
            </connector>
            <label>Vulnerability Management</label>
        </rules>
        <rules>
            <name>Compliance_Management</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Family</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliance Management</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_FamilyAbbr_CM</targetReference>
            </connector>
            <label>Compliance Management</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Product_Identifier</name>
