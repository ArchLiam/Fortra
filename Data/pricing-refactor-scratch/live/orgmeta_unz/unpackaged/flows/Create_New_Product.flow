        <rules>
            <name>Elite_Pattern</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Elite</stringValue>
                </rightValue>
