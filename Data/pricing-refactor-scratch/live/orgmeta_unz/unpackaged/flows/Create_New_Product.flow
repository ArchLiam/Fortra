    <description>Removed multiple currencies. Removed currencies selection in screen element.</description>
    <dynamicChoiceSets>
        <name>choiceCurrencies2</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>IsoCode</picklistField>
        <picklistObject>CurrencyType</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>varPriceBooks</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Pricebook2</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>FirstValue</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!varSelectedCurrencies2}, FIND(&apos;;&apos;,{!varSelectedCurrencies2})-1))</expression>
    </formulas>
    <formulas>
        <name>formAppendDeploymentToSKU</name>
        <dataType>String</dataType>
        <expression>IF({!Check_for_Deployment_Attribute.DefaultValue} = &quot;Software as a Service&quot;, &quot;SAAS&quot;,
IF({!Check_for_Deployment_Attribute.DefaultValue} = &quot;On-Premise&quot;, &quot;ONPR&quot;,
IF({!Check_for_Deployment_Attribute.DefaultValue} = &quot;Hybrid&quot;, &quot;HYBR&quot;,
IF({!Check_for_Deployment_Attribute.DefaultValue} = &quot;Cloud&quot;, &quot;CLUD&quot;, &quot;&quot;))))</expression>
    </formulas>
    <formulas>
        <name>GeneratedSKUForm</name>
        <dataType>String</dataType>
        <expression>&quot;SKU-&quot; + {!GeneratedProductCode}</expression>
    </formulas>
    <formulas>
        <name>GenerateProdCodForm</name>
        <dataType>String</dataType>
        <expression>{!CatalogAbbr} + &quot;-&quot; + {!FamilyAbbr} + &quot;-&quot; + {!ProductIdentifier} + &quot;-&quot; + {!TypeAbbr}</expression>
    </formulas>
    <formulas>
        <name>Other_Pattern</name>
        <dataType>String</dataType>
        <expression>UPPER(LEFT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!recordId.Name}, &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;), &quot;_&quot;, &quot;&quot;), 6))</expression>
    </formulas>
    <formulas>
        <name>PS_Package</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!recordId.Name}, &quot;Package 1&quot;), &quot;PS1&quot;,
       IF(CONTAINS({!recordId.Name}, &quot;Package 2&quot;), &quot;PS2&quot;,
       IF(CONTAINS({!recordId.Name}, &quot;Package 3&quot;), &quot;PS3&quot;, &quot;PS&quot;)))</expression>
    </formulas>
    <formulas>
        <name>RemainingValues</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE({!varSelectedCurrencies2},{!FirstValue}+&apos;;&apos;,&apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>SetFamilyAbbr</name>
        <dataType>String</dataType>
        <expression>UPPER(LEFT(SUBSTITUTE(TEXT({!recordId.Family}), &quot; &quot;, &quot;&quot;), 4))</expression>
    </formulas>
