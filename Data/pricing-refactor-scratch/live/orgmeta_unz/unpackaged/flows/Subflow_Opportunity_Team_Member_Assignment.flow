    <decisions>
        <name>AE_on_Sales_Territory_Decision</name>
        <label>AE on Sales Territory?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CAM_on_Sales_Territory_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_AE_on_Sales_Territory_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Product_Assignments.Sales_Territory__r.Account_Executive__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Already_in_AE_List_Decision</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>AE_OTM_Found_Decision</name>
        <label>AE - OTM Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Account_Executives</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_AE_OTM_Found_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AE_Find_OTM.singleOutputMember</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AE_Create_OTM</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Already_in_AE_List_Decision</name>
        <label>Already in AE List?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_to_AE_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Already_in_AE_List_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>accountExecutiveIdList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Product_Assignments.Sales_Territory__r.Account_Executive__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CAM_on_Sales_Territory_Decision</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Already_in_CAM_List_Decision</name>
