        <collectionReference>Get_Products_of_Interest</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Marketing_Product_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
