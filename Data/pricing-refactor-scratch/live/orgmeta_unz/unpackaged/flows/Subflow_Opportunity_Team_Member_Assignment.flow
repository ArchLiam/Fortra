                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Product_Assignments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>CAM_on_Sales_Territory_Decision</name>
        <label>CAM on Sales Territory?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Product_Assignments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_CAM_on_Sales_Territory_Outcome</name>
            <conditionLogic>and</conditionLogic>
