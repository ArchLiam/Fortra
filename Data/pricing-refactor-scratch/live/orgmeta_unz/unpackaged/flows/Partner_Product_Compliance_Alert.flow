    <decisions>
        <name>Any_Product_of_Interest_with_Solution_Group_Invalid</name>
        <label>Any Product of Interest with Solution Group Invalid?</label>
        <locationX>592</locationX>
        <locationY>1090</locationY>
        <defaultConnector>
            <targetReference>NoErrorScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO All Valid</defaultConnectorLabel>
        <rules>
            <name>YES_Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ProductofInterestwithSolutionGroupInvalidCollection</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorMessageScreen</targetReference>
            </connector>
            <label>YES Error</label>
        </rules>
    </decisions>
    <decisions>
        <name>Are_there_products</name>
        <label>Are there products?</label>
        <locationX>608</locationX>
        <locationY>531</locationY>
        <defaultConnector>
            <targetReference>No_Products_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO_Products</defaultConnectorLabel>
        <rules>
            <name>YES_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product_of_Interest</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Product_of_Interest</targetReference>
            </connector>
            <label>YES_Products</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Solution_Group_Valid</name>
        <label>Is Solution Group Valid?</label>
        <locationX>803</locationX>
        <locationY>953</locationY>
        <defaultConnector>
            <targetReference>Assign_ProductofInterestwithSolutionGroupInvalid</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Solution Group Invalid</defaultConnectorLabel>
        <rules>
            <name>YES_Solution_Group_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsProductValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Product_of_Interest</targetReference>
            </connector>
            <label>YES Solution Group Valid</label>
        </rules>
    </decisions>
    <description>Flow Label</description>
    <environments>Default</environments>
    <formulas>
        <description>1 = Valid
0 = Error</description>
        <name>IsProductValid</name>
        <dataType>Number</dataType>
        <expression>CASE(
  TEXT({!Loop_Product_of_Interest.Marketing_Product__r.Solution_Group__c}),
  &quot;Offensive Security&quot;, IF({!Get_Partner_Account.Offensive_Security__c}, 1, 0),
  &quot;Defensive Security&quot;, IF({!Get_Partner_Account.Defensive_Security__c}, 1, 0),
  &quot;XDR&quot;, IF({!Get_Partner_Account.XDR__c}, 1, 0),
  &quot;Managed File Transfer&quot;, IF({!Get_Partner_Account.Managed_File_Transfer__c}, 1, 0),
  &quot;Power&quot;, IF({!Get_Partner_Account.Power__c}, 1, 0),
  &quot;RPA Plus&quot;, IF({!Get_Partner_Account.RPA_Plus__c}, 1, 0),
  0
)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Partner Product Compliance Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Screen flow - Partner Product Compliance Alert</label>
    <loops>
