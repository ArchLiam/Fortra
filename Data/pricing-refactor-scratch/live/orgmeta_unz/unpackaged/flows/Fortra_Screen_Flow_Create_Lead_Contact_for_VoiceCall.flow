    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Contact_to_VoiceCall</name>
        <label>Assign Contact to VoiceCall</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VoiceCall_Record.RelatedRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>contactRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VoiceCall_Record.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>contactRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_VoiceCall_with_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Contact_Values</name>
        <label>Assign Contact Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>contactRecord.Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Phone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>contactRecord.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Select_Account_Record.selectedChoiceValues</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>contactRecord.Workday_Phone_Country_ISO_Code__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Phone_Country</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_to_VoiceCall</name>
        <label>Assign Lead to VoiceCall</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VoiceCall_Record.RelatedRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>leadRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_VoiceCall_with_Lead</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_Values</name>
        <label>Assign Lead Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>leadRecord.MobilePhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneForLead</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadRecord.LeadSource</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sales - Inbound Call</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Inquiry</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Account_Selected</name>
        <label>Account Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Inquiry_Creation_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome(NO)</defaultConnectorLabel>
        <rules>
            <name>YES_Account_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_Account_Record.selectedChoiceValues</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Select_Account_Record.selectedChoiceValues</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Select_Account_Record.selectedChoiceLabels</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Contact_Creation_Screen</targetReference>
            </connector>
            <label>YES Account Selected</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AccountRecords</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Account</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>phoneCountryPicklistValues</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Workday_Phone_Country_ISO_Code__c</picklistField>
        <picklistObject>Contact</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
