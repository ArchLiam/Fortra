    <decisions>
        <name>Cola_Only_Persisted</name>
        <label>COLA-Only Persisted?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Run_Pricing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run Full DPP</defaultConnectorLabel>
        <rules>
            <name>Cola_Only_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ColaOnlyPersistComplete</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Persist_Context</targetReference>
            </connector>
            <label>COLA Only Complete</label>
        </rules>
    </decisions>
    <description>Programmatic repricing flow for the Quote Migration Tool. Builds a context instance, runs Revenue Cloud pricing, and persists the results back to the Quote and QLI records.</description>
    <formulas>
        <name>ContextDataJson</name>
        <dataType>String</dataType>
        <expression>&apos;{&quot;Id&quot;:&quot;&apos; + {!QuoteId} + &apos;&quot;}&apos;</expression>
    </formulas>
    <interviewLabel>Fortra Quote Reprice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra Quote Reprice</label>
    <processMetadataValues>
