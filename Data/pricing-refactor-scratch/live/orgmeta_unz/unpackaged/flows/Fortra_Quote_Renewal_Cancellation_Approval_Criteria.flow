<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Is_Quote_a_Cancellation</name>
        <label>Is Quote a Cancellation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.Quote_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_record.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>cancellation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_Tier_is_the_Cancellation_Total_in</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Tier_is_the_Cancellation_Total_in</name>
        <label>What Tier is the Cancellation Total in?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Credit_Renewal_Approval_checkbox_to_True</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Less_Than_100k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.TotalPrice</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_record.TotalPrice</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>-100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_ScreenUpTo100k</targetReference>
            </connector>
            <label>Less Than 100k</label>
        </rules>
        <rules>
            <name>X101k_250k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.TotalPrice</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>-100001.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_record.TotalPrice</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>-250000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_Screen101k_250k</targetReference>
            </connector>
            <label>101k - 250k</label>
        </rules>
        <rules>
            <name>X250kPlus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.TotalPrice</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>-250000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_Screen250kPlus</targetReference>
            </connector>
            <label>250k+</label>
        </rules>
    </decisions>
    <description>SO: 4-18-26 - No changes - Saved as most recent for deployment</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Quote | Renewal Cancellation - Approval Criteria {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Quote | Renewal Cancellation - Approval Criteria</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Quote_record</name>
        <label>Get Quote record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Quote_a_Cancellation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Credit_Renewal_Approval_checkbox_to_True</name>
        <label>Update Credit Renewal Approval checkbox to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Renewal_Cancellation_Approval__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <screens>
        <name>Submission_Screen101k_250k</name>
        <label>Submission Screen101k-250k</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Credit_Renewal_Approval_checkbox_to_True</targetReference>
        </connector>
        <fields>
            <name>Between101k_250k</name>
            <fieldText>&lt;p&gt;You are sending a Renewal Cancellation between $100k and $250k for Approval.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Next</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Submission_Screen250kPlus</name>
        <label>Submission Screen250k+</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Credit_Renewal_Approval_checkbox_to_True</targetReference>
        </connector>
        <fields>
            <name>GreaterThan250k</name>
            <fieldText>&lt;p&gt;You are sending a Renewal Cancellation greater than $250k for Approval.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
