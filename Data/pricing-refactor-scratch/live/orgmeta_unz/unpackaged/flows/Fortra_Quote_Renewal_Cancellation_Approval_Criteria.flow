            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Next</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Submission_ScreenUpTo100k</name>
        <label>Submission ScreenUpTo100k</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Credit_Renewal_Approval_checkbox_to_True</targetReference>
        </connector>
        <fields>
            <name>UpTo100k</name>
            <fieldText>&lt;p&gt;You are sending a Renewal Cancellation up to $100k for Approval.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
