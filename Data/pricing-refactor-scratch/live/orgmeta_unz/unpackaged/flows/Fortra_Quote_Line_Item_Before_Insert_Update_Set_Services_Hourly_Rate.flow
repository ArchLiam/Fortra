<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Hourly_Prepaid</name>
        <label>Is Hourly Prepaid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Hourly_Recurring</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Hourly_Service_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.QuoteLineItemId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.AttributeValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>HourlyPrePaid</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Set_Services_Billing_Rate_and_Postpaid</targetReference>
            </connector>
            <label>Hourly Prepaid is True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Hourly_Recurring</name>
        <label>Is Hourly Recurring</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Post_Paid_Non_Hourly</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Hourly_Recurring_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.QuoteLineItemId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.AttributeValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>HourlyRecurring</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Set_Services_Billing_Rate</targetReference>
            </connector>
            <label>Hourly Recurring is True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Hourly_Service</name>
        <label>Is Hourly T&amp;M</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Hourly_Prepaid</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Hourly_Service_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.QuoteLineItemId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.AttributeValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>HourlyTM</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Services_Billing_Rate</targetReference>
            </connector>
            <label>Hourly T&amp;Mis True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Post_Paid_Non_Hourly</name>
        <label>Is Post Paid Non  Hourly</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_Services_Billing_Rate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_2_of_Hourly_Recurring_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.QuoteLineItemId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Line_Attributes.AttributeValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Postpaid</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_3_of_Set_Services_Billing_Rate</targetReference>
            </connector>
            <label>Post-Paid Non Hourly is True</label>
        </rules>
    </decisions>
    <description>Checks if the Services Type Quote Line Attribute is set hourly, and if so sets the Services Hourly Rate</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Quote Line Item | Before Insert/Update | Set Services Hourly Rate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Quote Line Item | Before Insert/Update | Set Services Hourly Rate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote_Line_Attributes</name>
        <label>Get Quote Line Attributes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Hourly_Service</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AttributeName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PS Service Type</stringValue>
            </value>
        </filters>
        <filters>
            <field>QuoteLineItemId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItemAttribute</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AttributeValue</queriedFields>
        <queriedFields>QuoteLineItemId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Clear_Services_Billing_Rate</name>
        <label>Clear Services Billing Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Postpaid_Service__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services_Hourly_Rate__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_2_of_Set_Services_Billing_Rate</name>
        <label>Set Services Billing Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Postpaid_Service__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services_Hourly_Rate__c</field>
            <value>
                <elementReference>$Record.NetUnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_2_of_Set_Services_Billing_Rate_and_Postpaid</name>
        <label>Set Services Billing Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Postpaid_Service__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services_Hourly_Rate__c</field>
            <value>
                <elementReference>$Record.NetUnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_3_of_Set_Services_Billing_Rate</name>
        <label>Clear Services Billing Rate Set Post Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Postpaid_Service__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services_Hourly_Rate__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Services_Billing_Rate</name>
        <label>Set Services Billing Rate and Postpaid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Postpaid_Service__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services_Hourly_Rate__c</field>
            <value>
                <elementReference>$Record.NetUnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote_Line_Attributes</targetReference>
        </connector>
        <filterFormula>{!$Permission.Data_Migration_Exclude_Business_Logic}=FALSE</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>HourlyPrePaid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Hourly - Pre-Paid</stringValue>
        </value>
    </variables>
    <variables>
        <name>HourlyRecurring</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Hourly - Recurring</stringValue>
        </value>
    </variables>
    <variables>
        <name>HourlyTM</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Hourly - T&amp;M</stringValue>
        </value>
    </variables>
    <variables>
        <name>Postpaid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Postpaid</stringValue>
        </value>
    </variables>
    <variables>
        <name>Prepaid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Prepaid</stringValue>
        </value>
    </variables>
</Flow>
