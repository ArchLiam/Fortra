    <screens>
        <name>Error_Inquiry_Owner_is_a_Queue</name>
        <label>Error Inquiry Owner is a Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Error_Inquiry_Owner_is_a_Queue_DisplayText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;⚠️ &lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Conversion unavailable.&lt;/strong&gt;&lt;strong&gt; One or more of the selected Inquiries are owned by a Queue. &lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Please change the Owner or reach out to your system administrator for help.&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Inquiry_Unmet_conditions</name>
        <label>Error Inquiry Unmet conditions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Error_Inquiry_Owner_is_a_Queue_DisplayText_0</name>
            <fieldText>&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;⚠️ &lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Conversion unavailable. &lt;/strong&gt;&lt;strong&gt;This record cannot be converted due to one or more unmet conditions.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please review the following items before trying again, or contact your system administrator for assistance:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Account ID&lt;/strong&gt; may need to be populated&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Owner&lt;/strong&gt; must not be a Queue&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
