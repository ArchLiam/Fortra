    <decisions>
        <name>Additional_Inquiries_Selected</name>
        <label>Additional Inquiries Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_triggering_Inquiry_to_InquiriesToConvert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Additional Inquiries Selected</defaultConnectorLabel>
        <rules>
            <name>YES_Additional_Inquiries_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_inquiries_Screen.selectedRows</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_selected_rows_to_InquiriesToConvert</targetReference>
            </connector>
            <label>YES Additional Inquiries Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Existing_Opportunity_Selected</name>
        <label>Existing Opportunity Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_same_Contact_Unit_Inquiries</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Existing Opportunity Selected</defaultConnectorLabel>
        <rules>
            <name>YES_Existing_Opportunity_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Open_Opportunities_DataTable.firstSelectedRow</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Triggering_Inquiry_fields</targetReference>
            </connector>
            <label>YES Existing Opportunity Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Get_same_Contact_Unit_Inquiries_is</name>
        <label>Get same Contact/Unit Inquiries is</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Select_Inquiries_to_Convert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>YES same Contact/Unit Inquiries</defaultConnectorLabel>
        <rules>
            <name>NO_same_Contact_Unit_Inquiries</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_same_Contact_Unit_Inquiries</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_triggering_Inquiry_to_InquiriesToConvert</targetReference>
            </connector>
            <label>NO same Contact/Unit Inquiries</label>
        </rules>
    </decisions>
    <decisions>
        <name>Inquiry_Check</name>
        <label>Inquiry Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Meets Requirements</defaultConnectorLabel>
        <rules>
            <name>Unmet_Requirements</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_triggering_Inquiry.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_triggering_Inquiry.Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Inquiry_Unmet_conditions</targetReference>
            </connector>
            <label>Unmet Requirements</label>
        </rules>
    </decisions>
    <decisions>
        <description>The purpone of this decision is to prevent Error on OTM creation when Inquiry Owner is a Queue.</description>
        <name>Is_Inquiry_Owner_a_Queue</name>
        <label>Is Inquiry Owner a Queue?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Inquiries_Ids_to_Text_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Owner is a User</defaultConnectorLabel>
        <rules>
            <name>YES_Owner_is_a_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Inquiries_to_Convert.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Inquiry_Owner_is_a_Queue</targetReference>
            </connector>
            <label>YES Owner is a Queue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_any_Exisiting_Open_Opportunity</name>
        <label>Is there any Exisiting Open Opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_same_Contact_Unit_Inquiries</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Exisiting Open Opportunity</defaultConnectorLabel>
        <rules>
            <name>YES_Exisiting_Open_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Opportunities</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Existing_Opportunities_Screen</targetReference>
            </connector>
            <label>YES Exisiting Open Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Product_of_Interest_VAR_is_Blank</name>
        <label>Product of Interest VAR is Blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Review_Products_of_Interest_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome(NO)</defaultConnectorLabel>
        <rules>
            <name>POI_isBlank</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>productOfInterestTerritory</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>productOfInterestTerritory</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Territory_to_Opportunity</targetReference>
            </connector>
            <label>POI isBlank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Unique_Owner</name>
        <label>Unique Owner?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_OTM_fields_AEs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New</defaultConnectorLabel>
        <rules>
            <name>NotNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewOpportunityTeamMemberUsersTextCollection</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Inquiry_Owners</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Inquiry_Owners</targetReference>
            </connector>
            <label>Not New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Unique_User_CAM</name>
        <label>Unique User? (CAM)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_OTM_fieldsCAMs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New CAM</defaultConnectorLabel>
        <rules>
            <name>Not_New_CAM_or_Null</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>NewOpportunityTeamMemberUsersTextCollection</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Partner_Managers</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Partner_Managers</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Loop_Partner_Managers</targetReference>
            </connector>
            <label>Not New CAM or Null</label>
        </rules>
    </decisions>
    <description>2026-05-28: Add default values to Opportunity form required fields</description>
    <dynamicChoiceSets>
        <name>Deal_Origin_ChoiseSet</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Deal_Origin__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>CyberorTechAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISBLANK({!Amount_Cyber})),
    {!Amount_Cyber},
    {!Amount_Tech}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CyberorTechBudgetAllocated</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Budget_Allocated_Cyber})),
    {!Budget_Allocated_Cyber},
    null
  )</expression>
    </formulas>
    <formulas>
        <name>CyberorTechDealOrigin</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Deal_Origin_Cyber})),
   {!Deal_Origin_Cyber},
   {!Deal_Origin_Tech}
)</expression>
    </formulas>
    <formulas>
        <name>CyberorTechDescription</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Description_Cyber})),
    {!Description_Cyber},
    {!Description_Tech}
)</expression>
    </formulas>
    <formulas>
        <name>CyberorTechDisplacedARR</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISBLANK({!Displaced_ARR_Tech})),
    {!Displaced_ARR_Tech},
    null
  )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CyberorTechExpectedRevenue</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISBLANK({!Expected_Revenue_Cyber})),
    {!Expected_Revenue_Cyber},
    {!Expected_Revenue_Tech}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CyberorTechOpportunityType</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Opportunity_Type_Tech})),
   {!Opportunity_Type_Tech},
    null
  )</expression>
    </formulas>
    <formulas>
        <name>HyperlinkFormulaNewOpportunity</name>
        <dataType>String</dataType>
        <expression>HYPERLINK(&quot;/&quot; &amp; {!NewOpportunityRecord.Id} , {!NewOpportunityRecord.Name} )</expression>
    </formulas>
    <formulas>
        <name>HyperlinkFormulaSelectedExistingOpportunity</name>
        <dataType>String</dataType>
        <expression>HYPERLINK(&quot;/&quot; &amp; {!Existing_Open_Opportunities_DataTable.firstSelectedRow.Id} , {!Existing_Open_Opportunities_DataTable.firstSelectedRow.Name} )</expression>
    </formulas>
    <formulas>
        <name>OpportunityCloseDateDefault</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 90</expression>
    </formulas>
    <formulas>
        <name>OpportunityNameDefault</name>
        <dataType>String</dataType>
        <expression>{!Get_triggering_Inquiry.Account__r.Name} &amp; &quot;.&quot; &amp; CASE(MONTH(TODAY()),1,&quot;January&quot;,2,&quot;February&quot;,3,&quot;March&quot;,4,&quot;April&quot;,5,&quot;May&quot;,6,&quot;June&quot;,7,&quot;July&quot;,8,&quot;August&quot;,9,&quot;September&quot;,10,&quot;October&quot;,11,&quot;November&quot;,12,&quot;December&quot;,&quot;&quot;) &amp; &quot;.&quot; &amp; TEXT(YEAR(TODAY()))</expression>
    </formulas>
