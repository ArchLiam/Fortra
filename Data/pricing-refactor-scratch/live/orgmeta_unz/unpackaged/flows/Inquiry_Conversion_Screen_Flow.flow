    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_triggering_Inquiry</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ErrorDetailsTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;ul&gt;&lt;li&gt;Triggering Inquiry Id: {!Get_triggering_Inquiry.Id}&lt;/li&gt;&lt;li&gt;Interview Start Date/TIme: &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Flow.InterviewStartTime} &lt;/span&gt;&lt;/li&gt;&lt;li&gt;Fault Message: {!$Flow.FaultMessage}&lt;/li&gt;&lt;/ul&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>SummaryTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;ul&gt;&lt;li&gt;Name: {!NewOpportunityRecord.Name}&lt;/li&gt;&lt;li&gt;Account Name: {!NewOpportunityRecord.Account.Name}&lt;/li&gt;&lt;li&gt;Stage: {!NewOpportunityRecord.StageName}&lt;/li&gt;&lt;li&gt;Close Date: {!NewOpportunityRecord.CloseDate}&lt;/li&gt;&lt;li&gt;Amount: {!CyberorTechAmount}&lt;/li&gt;&lt;li&gt;Expected Revenue: {!CyberorTechExpectedRevenue}&lt;/li&gt;&lt;li&gt;Owner: {!NewOpportunityRecord.Owner.FirstName} &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!NewOpportunityRecord.Owner.LastName} &lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</text>
    </textTemplates>
