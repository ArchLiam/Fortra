    <decisions>
        <name>Record_Type_Check</name>
        <label>Record Type Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Enter_Product_of_Interest_Info_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Opportunity</defaultConnectorLabel>
        <rules>
            <name>Is_Sales_Inquiry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sales_Inquiry</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enter_Product_of_Interest_Info_Lead</targetReference>
            </connector>
            <label>Is Sales Inquiry</label>
        </rules>
    </decisions>
    <description>2026-04-08: Adding Error Screen
2026-02-18: Flow Label</description>
    <dynamicChoiceSets>
        <name>Marketing_Product</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Marketing_Product__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
