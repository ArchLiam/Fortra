<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Quote_Fields</name>
        <label>Set Quote Fields</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <assignmentItems>
            <assignToReference>Quote_To_Update.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Opportunity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.LegalEntityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contract.Legal_Entity__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.Renewal_Contract__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contract.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.Renewal_Value__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Opportunity.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.Bill_To_Place__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Opportunity.Bill_To_Place__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.Ship_To_Place__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Opportunity.Ship_To_Place__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Quote_To_Update.BillToContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Order.BillToContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote</targetReference>
        </connector>
    </assignments>
    <description>Enhances renewal Quotes (OriginalActionType = Renew) that the broken createRenewalQuote override leaves bare. Reads the Contract and its standing Renewal Opportunity directly (no asset-to-order lineage), creates a fresh Renewal Opportunity, and stamps OpportunityId + LegalEntityId + Renewal_Contract__c onto the Quote. Runs async via a scheduled path after the renewal transaction commits.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Standing_Renewal_Opp.CloseDate}), TODAY() + 365, {!Get_Standing_Renewal_Opp.CloseDate})</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityName</name>
        <dataType>String</dataType>
        <expression>&quot;Renewal - &quot; &amp; {!Get_Contract.Account.Name} &amp; &quot; - &quot; &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>formula_StageName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!Get_Standing_Renewal_Opp.StageName})), &quot;Pricing &amp; Approval&quot;, TEXT({!Get_Standing_Renewal_Opp.StageName}))</expression>
    </formulas>
    <interviewLabel>Fortra | Renewal Quote Enhancement {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Renewal Quote Enhancement</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Opportunity</name>
        <label>Create Renewal Opportunity</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <connector>
            <targetReference>Set_Quote_Fields</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Get_Contract.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>Get_Source_Opportunity.Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Bill_To_Place__c</field>
            <value>
                <elementReference>Get_Source_Opportunity.Bill_To_Place__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>formula_CloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>$Record.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Expected_Renewal_Date__c</field>
            <value>
                <elementReference>Get_Standing_Renewal_Opp.Expected_Renewal_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadSource</field>
            <value>
                <elementReference>Get_Standing_Renewal_Opp.LeadSource</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Legal_Entity__c</field>
            <value>
                <elementReference>Get_Contract.Legal_Entity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>formula_OpportunityName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricebook2Id</field>
            <value>
                <elementReference>Get_Standing_Renewal_Opp.Pricebook2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Renewed_Contract__c</field>
            <value>
                <elementReference>Get_Contract.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sale_Type__c</field>
            <value>
                <elementReference>Get_Standing_Renewal_Opp.Sale_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ship_To_Place__c</field>
            <value>
                <elementReference>Get_Source_Opportunity.Ship_To_Place__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <elementReference>formula_StageName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Territory__c</field>
            <value>
                <elementReference>Get_Standing_Renewal_Opp.Territory__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Contract</name>
        <label>Get Contract</label>
        <locationX>176</locationX>
        <locationY>434</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Standing_Renewal_Opp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContractId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_Opportunity</name>
        <label>Get Source Opportunity</label>
        <locationX>176</locationX>
        <locationY>596</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Source_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.SourceOpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_Order</name>
        <label>Get Source Order</label>
        <locationX>176</locationX>
        <locationY>620</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.SourceOrderId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Standing_Renewal_Opp</name>
        <label>Get Standing Renewal Opportunity</label>
        <locationX>176</locationX>
        <locationY>542</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Source_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.Renewal_Opportunity__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote</name>
        <label>Update Quote</label>
        <locationX>176</locationX>
        <locationY>866</locationY>
        <inputReference>Quote_To_Update</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OriginalActionType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renew</stringValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Run_After_Commit</name>
            <connector>
                <targetReference>Get_Contract</targetReference>
            </connector>
            <label>Run After Commit</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Quote_To_Update</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Quote</objectType>
    </variables>
</Flow>
