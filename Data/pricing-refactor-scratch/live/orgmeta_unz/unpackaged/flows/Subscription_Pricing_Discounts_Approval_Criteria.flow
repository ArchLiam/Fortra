    <assignments>
        <name>Assign_QLI_to_Collection_Variable_50</name>
        <label>Assign QLI to Collection Variable 50+</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ColVarQLIsGreaterThan50Discount</assignToReference>
