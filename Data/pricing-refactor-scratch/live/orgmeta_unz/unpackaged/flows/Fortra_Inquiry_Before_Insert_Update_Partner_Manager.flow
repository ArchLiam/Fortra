<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Partner_Manager</name>
        <label>Assign Partner Manager</label>
        <locationX>690</locationX>
        <locationY>441</locationY>
        <assignmentItems>
            <assignToReference>$Record.Partner_Manager__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PartnerAccount.Primary_Channel_Account_Manager__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Update_Partner_Manager_Decision</name>
        <label>Update Partner Manager Decision</label>
        <locationX>808</locationX>
        <locationY>340</locationY>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>YES_Update_Partner_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Update_Account_Manager</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PartnerAccount.Primary_Channel_Account_Manager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Partner_Manager</targetReference>
            </connector>
            <label>YES Update Partner Manager</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Update_Account_Manager</name>
        <dataType>Boolean</dataType>
        <expression>OR( 
(ISNEW() &amp;&amp; NOT(ISBLANK({!$Record.PartnerAccountId}))),
ISCHANGED({!$Record.PartnerAccountId})
)</expression>
    </formulas>
    <interviewLabel>Fortra | Inquiry | Before Insert/Update - Partner Manager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Inquiry | Before Insert/Update - Partner Manager</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>690</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Update_Partner_Manager_Decision</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
