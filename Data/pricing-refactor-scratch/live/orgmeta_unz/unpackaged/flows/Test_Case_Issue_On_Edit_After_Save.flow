<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Chatter_TESTER_ready_for_retest</name>
        <label>Chatter TESTER ready for retest</label>
        <locationX>468</locationX>
        <locationY>632</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>text</name>
            <value>
                <elementReference>PosttoTester</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value>
                <elementReference>$Record.Test_Case__r.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>chatterPost</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Pass</name>
        <label>TC Status - Pass</label>
        <locationX>576</locationX>
        <locationY>375</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TC_Status_FAIL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Test_Case__r.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ready4retest</targetReference>
            </connector>
            <label>TC Status FAIL</label>
        </rules>
    </decisions>
    <description>11/15 - corrected the Decision Tree - to run if the record triggered was updated.
Update flow to suppress the READY FOR RETEST chatter if the Case is PASSED by user without TCI resolved.</description>
    <environments>Default</environments>
    <interviewLabel>Test Case Issue - On Edit (After Save) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Case Issue - On Edit (After Save)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>ready4retest</name>
        <label>ready4retest</label>
        <locationX>468</locationX>
        <locationY>465</locationY>
        <connector>
            <targetReference>Chatter_TESTER_ready_for_retest</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Test_Case__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Ready for Retest</stringValue>
            </value>
        </inputAssignments>
        <object>Test_Cases__c</object>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Pass</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Issue_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Issue_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Feedback_Enhancement_Request__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Test_Case_Issues__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>PosttoTester</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>@[{!$Record.Test_Case__r.Tester__r.Id}] This UAT test case has been updated to &quot;Ready for Retest&quot;.</text>
    </textTemplates>
    <variables>
        <name>PreviousTCIssue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Test_Case_Issues__c</objectType>
    </variables>
    <variables>
        <name>RelatedTestCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Test_Cases__c</objectType>
    </variables>
    <variables>
        <name>sovTestCaseToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Test_Cases__c</objectType>
    </variables>
</Flow>
