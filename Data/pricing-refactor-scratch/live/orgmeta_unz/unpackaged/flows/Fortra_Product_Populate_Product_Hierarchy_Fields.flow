    <recordUpdates>
        <name>Update_Product_Records</name>
        <label>Update Product Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Through_Get_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Through_Get_Records.ProductId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Parent_Category_Name__c</field>
            <value>
