<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Calc_Renewal_Amount</name>
        <label>Calc Renewal Amount</label>
        <locationX>50</locationX>
        <locationY>840</locationY>
        <actionName>RenewalForecastAmount</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Amount_Returned</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contractId</name>
            <value>
                <elementReference>Get_Amended_Contract.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>RenewalForecastAmount</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Send_Bell</name>
        <label>Send Bell</label>
        <locationX>50</locationX>
        <locationY>1920</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>Loop_Quotes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_Quotes</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Renewal quote needs review</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>form_BellBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>Loop_Quotes.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Recipients</name>
        <label>Build Recipients</label>
        <locationX>50</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Renewal_Opp.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Calc_Renewal_Amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Swallow_Fault</name>
        <label>Swallow Fault</label>
        <locationX>450</locationX>
        <locationY>1200</locationY>
        <assignmentItems>
            <assignToReference>faultCaptured</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>handled</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Already_Converted</name>
        <label>Already Converted?</label>
        <locationX>50</locationX>
        <locationY>1680</locationY>
        <defaultConnector>
            <targetReference>Loop_Quotes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Converted - Skip</defaultConnectorLabel>
        <rules>
            <name>Not_Converted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Activated_Order.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Quote_Stale</targetReference>
            </connector>
            <label>Not Converted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Amount_Returned</name>
        <label>Amount Returned?</label>
        <locationX>50</locationX>
        <locationY>960</locationY>
        <defaultConnector>
            <targetReference>Update_Opp_Date_Only</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Amount</defaultConnectorLabel>
        <rules>
            <name>Has_Amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Calc_Renewal_Amount.amount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_With_Amount</targetReference>
            </connector>
            <label>Has Amount</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Standing_Renewal_Opp</name>
        <label>Has Standing Renewal Opp?</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <defaultConnectorLabel>No Standing Opp</defaultConnectorLabel>
        <rules>
            <name>Has_Opp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Amended_Contract.Renewal_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Renewal_Opp</targetReference>
            </connector>
            <label>Has Standing Opp</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Amendment</name>
        <label>Is Amendment?</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>Not an Amendment</defaultConnectorLabel>
        <rules>
            <name>Yes_Amendment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Quote.Quote_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Amendment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Quote.Renewal_Contract__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Amended_Contract</targetReference>
            </connector>
            <label>Yes - Amendment</label>
        </rules>
    </decisions>
    <description>R2b: When an amendment Order activates, refresh the amended contract&apos;s standing renewal Opportunity (Amount via RenewalForecastAmount + CloseDate) and flag any not-yet-converted renewal Quote stale, notifying the owner via an in-app (bell) custom notification. Every faultable element has a fault path so a sync failure never rolls back the amendment.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_BellBody</name>
        <dataType>String</dataType>
        <expression>&apos;Renewal quote &apos; &amp; {!Loop_Quotes.Name} &amp; &apos; may be out of date — contract &apos; &amp; {!Get_Amended_Contract.ContractNumber} &amp; &apos; was amended. Review before sending.&apos;</expression>
    </formulas>
    <interviewLabel>Fortra Amendment Sync To Renewal Opp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra Amendment Sync To Renewal Opp</label>
    <loops>
        <name>Loop_Quotes</name>
        <label>Loop Quotes</label>
        <locationX>50</locationX>
        <locationY>1440</locationY>
        <collectionReference>Get_Renewal_Quotes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Activated_Order</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Activated_Order</name>
        <label>Get Activated Order</label>
        <locationX>50</locationX>
        <locationY>1560</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Already_Converted</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_Quotes</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Quotes.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Amended_Contract</name>
        <label>Get Amended Contract</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Standing_Renewal_Opp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Quote.Renewal_Contract__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContractNumber</queriedFields>
        <queriedFields>EndDate</queriedFields>
        <queriedFields>Renewal_Opportunity__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>50</locationX>
        <locationY>1320</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Quotes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renewal_Quote_Stale</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Quote</name>
        <label>Get Related Quote</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Amendment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quote_Type__c</queriedFields>
        <queriedFields>Renewal_Contract__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal_Opp</name>
        <label>Get Renewal Opp</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Build_Recipients</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Amended_Contract.Renewal_Opportunity__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal_Quotes</name>
        <label>Get Renewal Quotes</label>
        <locationX>50</locationX>
        <locationY>1200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Notification_Type</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Renewal_Opp.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Quote_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </filters>
        <filters>
            <field>Renewal_Quote_Stale__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Flag_Quote_Stale</name>
        <label>Flag Quote Stale</label>
        <locationX>50</locationX>
        <locationY>1800</locationY>
        <connector>
            <targetReference>Send_Bell</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_Quotes</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Quotes.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Renewal_Quote_Stale__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp_Date_Only</name>
        <label>Update Opp Date Only</label>
        <locationX>250</locationX>
        <locationY>1080</locationY>
        <connector>
            <targetReference>Get_Renewal_Quotes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Renewal_Opp.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>Get_Amended_Contract.EndDate</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp_With_Amount</name>
        <label>Update Opp With Amount</label>
        <locationX>50</locationX>
        <locationY>1080</locationY>
        <connector>
            <targetReference>Get_Renewal_Quotes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Swallow_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Renewal_Opp.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>Calc_Renewal_Amount.amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>Get_Amended_Contract.EndDate</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>faultCaptured</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
