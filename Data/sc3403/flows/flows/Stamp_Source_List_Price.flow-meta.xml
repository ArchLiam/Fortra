<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Contributor_From_First</name>
        <label>Assign Contributor From First</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContributingProductId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First_Derived.ContributingProductId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Multiple_Derived</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Derived_Count</name>
        <label>Assign Derived Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDerivedCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Derived_Prices</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Has_Derived_Prices</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Stamp_Source_List_Price</name>
        <label>Stamp Source List Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Source_List_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_PBE.UnitPrice</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Alt_Contributor_Exists</name>
        <label>Check Alt Contributor Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ambiguous Contributor</defaultConnectorLabel>
        <rules>
            <name>Contributor_Unique</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Alt_Contributor</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Source_PBE</targetReference>
            </connector>
            <label>Contributor Unique</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Has_Derived_Prices</name>
        <label>Check Has Derived Prices</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Derived Prices</defaultConnectorLabel>
        <rules>
            <name>Has_Derived_Prices</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDerivedCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First_Derived</targetReference>
            </connector>
            <label>Has Derived Prices</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Multiple_Derived</name>
        <label>Check Multiple Derived</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Source_PBE</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Single Derived Price</defaultConnectorLabel>
        <rules>
            <name>Multiple_Derived_Prices</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDerivedCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Alt_Contributor</targetReference>
            </connector>
            <label>Multiple Derived Prices</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Derived_Line</name>
        <label>Is Derived Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Derived</defaultConnectorLabel>
        <rules>
            <name>Derived_Line</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Maintenance_PBE</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Maintenance_PBE.IsDerived</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote</targetReference>
            </connector>
            <label>Derived Line</label>
        </rules>
    </decisions>
    <decisions>
        <name>Source_PBE_Found</name>
        <label>Source PBE Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source_PBE</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Source_List_Price</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>On derived maintenance/support quote line create or source change, resolves the contributing license via PriceBookEntryDerivedPrice and stamps its non-derived list price into Source_List_Price__c for Rev_Mgmt derived pricing. Lines with multiple contributors are left null for manual review.</description>
    <environments>Default</environments>
    <interviewLabel>Stamp Source List Price {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stamp Source List Price</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Alt_Contributor</name>
        <label>Get Alt Contributor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Alt_Contributor_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PricebookEntryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PricebookEntryId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContributingProductId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>varContributingProductId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PriceBookEntryDerivedPrice</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Derived_Prices</name>
        <label>Get Derived Prices</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Derived_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PricebookEntryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PricebookEntryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PriceBookEntryDerivedPrice</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_First_Derived</name>
        <label>Get First Derived</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Contributor_From_First</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PricebookEntryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PricebookEntryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PriceBookEntryDerivedPrice</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Maintenance_PBE</name>
        <label>Get Maintenance PBE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Derived_Line</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PricebookEntryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Derived_Prices</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_PBE</name>
        <label>Get Source PBE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Source_PBE_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varContributingProductId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Pricebook2Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CurrencyIsoCode</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.CurrencyIsoCode</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsDerived</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Maintenance_PBE</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.PricebookEntryId})),OR(ISNEW(),ISCHANGED({!$Record.Product2Id}),ISCHANGED({!$Record.PricebookEntryId}),ISBLANK({!$Record.Source_List_Price__c})))</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varContributingProductId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varDerivedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
