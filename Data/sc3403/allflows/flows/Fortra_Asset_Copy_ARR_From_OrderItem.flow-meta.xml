<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Asset_Action_Found</name>
        <label>Asset Action Found?</label>
        <locationX>611</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No Asset Action</defaultConnectorLabel>
        <rules>
            <name>Asset_Action_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset_Action</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Asset_Action_Source</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_OrderItem_Has_ARR</name>
        <label>OrderItem Has ARR to Copy?</label>
        <locationX>182</locationX>
        <locationY>863</locationY>
        <defaultConnectorLabel>No ARR or Same Value</defaultConnectorLabel>
        <rules>
            <name>ARR_Needs_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order_Item.Order_Line_ARR__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Order_Item.Order_Line_ARR__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ARR__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Asset_ARR</targetReference>
            </connector>
            <label>Yes - Update Needed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Source_Found</name>
        <label>Asset Action Source Found?</label>
        <locationX>380</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>No Source</defaultConnectorLabel>
        <rules>
            <name>Source_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset_Action_Source</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Asset_Action_Source.ReferenceEntityItemId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order_Item</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>2026-02-18 Flow Label
Copies Order_Line_ARR__c from OrderItem directly to Asset.ARR__c after Asset creation during order activation. Traverses: Asset → AssetAction → AssetActionSource → OrderItem (via ReferenceEntityItemId).</description>
    <environments>Default</environments>
    <interviewLabel>Fortra - Asset Copy ARR From OrderItem {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Asset | After Insert/Update - Copy ARR From OrderItem</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Asset_Action</name>
        <label>Get Asset Action</label>
        <locationX>611</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Asset_Action_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetAction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Asset_Action_Source</name>
        <label>Get Asset Action Source</label>
        <locationX>380</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Source_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetActionId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Asset_Action.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetActionSource</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Order_Item</name>
        <label>Get Order Item</label>
        <locationX>182</locationX>
        <locationY>755</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_OrderItem_Has_ARR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Asset_Action_Source.ReferenceEntityItemId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OrderItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Asset_ARR</name>
        <label>Update Asset ARR</label>
        <locationX>50</locationX>
        <locationY>971</locationY>
        <inputAssignments>
            <field>ARR__c</field>
            <value>
                <elementReference>Get_Order_Item.Order_Line_ARR__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>485</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Asset_Action</targetReference>
        </connector>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
