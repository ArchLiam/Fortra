<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Total_Custom_Count</name>
        <label>Add to Total Custom Count</label>
        <locationX>440</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>varTotalCustomCount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCreatedCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Custom_Pricebooks</targetReference>
        </connector>
    </assignments>
    <description>Simplified parent flow to update multi-currency pricebook entries via Quick Action - FIXED: Creates Standard Pricebook entries first</description>
    <label>Fortra | Product | Update Multi-Currency Prices</label>
    <loops>
        <name>Loop_Custom_Pricebooks</name>
        <label>Loop Through Custom Pricebooks</label>
        <locationX>176</locationX>
        <locationY>674</locationY>
        <assignNextValueToReference>curCustomPricebook</assignNextValueToReference>
        <collectionReference>colCustomPricebooks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Call_SubFlow_Custom</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Screen_Success</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Custom_Pricebook_Entries</name>
        <label>Get Custom Pricebook Entries for Product</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Price_Input</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Pricebook2Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>varStandardPricebookId</elementReference>
            </value>
        </filters>
        <object>PricebookEntry</object>
        <outputReference>colCustomPricebooks</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Pricebook2Id</queriedFields>
        <queriedFields>Product2Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Product2_Record</name>
        <label>Get Product2 Record</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Standard_Pricebook</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Product2</object>
        <outputReference>varProduct2Record</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Standard_Pricebook</name>
        <label>Get Standard Pricebook</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Custom_Pricebook_Entries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsStandard</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Pricebook2</object>
        <outputAssignments>
            <assignToReference>varStandardPricebookId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <screens>
        <name>Screen_Price_Input</name>
        <label>Update Currency Prices</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Call_SubFlow_Standard</targetReference>
        </connector>
        <fields>
            <name>display_ProductName</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Product:&lt;/b&gt; {!varProduct2Record.Name}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>display_Info</name>
            <fieldText>&lt;p&gt;This will update existing pricebook entries or create new multi-currency entries based on the USD price you enter.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;What happens:&lt;/b&gt;&lt;/p&gt;&lt;p&gt;1. For each currency (USD, EUR, GBP, CAD, etc.):&lt;/p&gt;&lt;p&gt;   • If entry exists → Update price&lt;/p&gt;&lt;p&gt;   • If entry doesn&apos;t exist → Create new entry&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;2. Process Standard Pricebook first, then Custom Pricebook&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;i&gt;Note: All currencies will be properly updated without conflicts.&lt;/i&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>input_NewUSDPrice</name>
            <dataType>Currency</dataType>
            <fieldText>New USD Base Price</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>Enter the USD price that will be used to calculate all currency prices</helpText>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Success</name>
        <label>Update Complete</label>
        <locationX>176</locationX>
        <locationY>890</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_Success</name>
            <fieldText>&lt;p&gt;&lt;b style=&quot;color: rgb(0, 128, 0);&quot;&gt;✓ Success!&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Product:&lt;/b&gt; {!varProduct2Record.Name}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Standard Pricebook:&lt;/b&gt; {!varStandardCreatedCount} entries updated/created&lt;/p&gt;&lt;p&gt;&lt;b&gt;All Custom Pricebooks:&lt;/b&gt; {!varTotalCustomCount} entries updated/created&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Multi-currency pricebook entries have been updated successfully across all pricebooks.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Product2_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_SubFlow_Custom</name>
        <label>Call SubFlow for Each Custom Pricebook</label>
        <locationX>440</locationX>
        <locationY>674</locationY>
        <connector>
            <targetReference>Add_To_Total_Custom_Count</targetReference>
        </connector>
        <flowName>Fortra_Product_Update_Currency_Prices_SubFlow</flowName>
        <inputAssignments>
            <name>varProduct2Id</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPricebook2Id</name>
            <value>
                <elementReference>curCustomPricebook.Pricebook2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varUSD_Base_Price</name>
            <value>
                <elementReference>input_NewUSDPrice</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varCreatedCount</assignToReference>
            <name>varCreatedCount</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Call_SubFlow_Standard</name>
        <label>Call SubFlow Standard Pricebook</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Loop_Custom_Pricebooks</targetReference>
        </connector>
        <flowName>Fortra_Product_Update_Currency_Prices_SubFlow</flowName>
        <inputAssignments>
            <name>varProduct2Id</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPricebook2Id</name>
            <value>
                <elementReference>varStandardPricebookId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varUSD_Base_Price</name>
            <value>
                <elementReference>input_NewUSDPrice</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varStandardCreatedCount</assignToReference>
            <name>varCreatedCount</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>colCustomPricebooks</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>curCustomPricebook</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCreatedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varNewUSDPrice</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varProduct2Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Product2</objectType>
    </variables>
    <variables>
        <name>varStandardCreatedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varStandardPricebookId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTotalCustomCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varUSDCustomEntry</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>varUSDStandardEntry</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
</Flow>
