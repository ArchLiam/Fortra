<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks whether a Generate-type AssetAction was found for this Asset.</description>
        <name>Has_Asset_Action</name>
        <label>Has Asset Action?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Action</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAssetAction.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Asset_Action_Source</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether an AssetActionSource was found with quantity and amount data.</description>
        <name>Has_Asset_Action_Source</name>
        <label>Has Asset Action Source?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Source</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAssetActionSource.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Source_Order_Item</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Populates legacy Asset fields (Status, Quantity, Price) on lifecycle-managed Assets after creation. Runs AsyncAfterCommit on Asset insert to ensure AssetAction and AssetActionSource records are committed and visible. This decouples legacy field population from the Assetize Order flow to avoid transaction timing issues.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns &apos;Months&apos; when the source OrderItem has a SubscriptionTerm, otherwise null. Prevents INVALID_INPUT error from setting RenewalTermUnit without RenewalTerm.</description>
        <name>fmRenewalTermUnit</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varOrderItem.SubscriptionTerm}), NULL, &apos;Months&apos;)</expression>
    </formulas>
    <interviewLabel>Fortra - Asset Populate Legacy Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra - Asset Populate Legacy Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the most recent Generate-type AssetAction for this Asset. The AssetAction is created by createOrUpdateAssetFromOrder.</description>
        <name>Get_Asset_Action</name>
        <label>Get Asset Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Asset_Action</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Generate</stringValue>
            </value>
        </filters>
        <object>AssetAction</object>
        <outputReference>varAssetAction</outputReference>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>Gets the AssetActionSource linked to the AssetAction. Contains the Quantity and TotalLineAmount from the source OrderItem.</description>
        <name>Get_Asset_Action_Source</name>
        <label>Get Asset Action Source</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Asset_Action_Source</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetActionId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAssetAction.Id</elementReference>
            </value>
        </filters>
        <object>AssetActionSource</object>
        <outputReference>varAssetActionSource</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>TotalLineAmount</queriedFields>
        <queriedFields>ReferenceEntityItemId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>Gets the parent Order to retrieve Legacy_Id__c for propagation to the Asset.</description>
        <name>Get_Source_Order</name>
        <label>Get Source Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Asset_Legacy_Fields</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOrderItem.OrderId</elementReference>
            </value>
        </filters>
        <object>Order</object>
        <outputReference>varOrder</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Legacy_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Gets the source OrderItem from the AssetActionSource to retrieve the parent Order ID and Hardware lookup.</description>
        <name>Get_Source_Order_Item</name>
        <label>Get Source Order Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Source_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAssetActionSource.ReferenceEntityItemId</elementReference>
            </value>
        </filters>
        <object>OrderItem</object>
        <outputReference>varOrderItem</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OrderId</queriedFields>
        <queriedFields>Hardware_ID__c</queriedFields>
        <queriedFields>SubscriptionTerm</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>Sets the legacy Asset fields: Status to Installed, Quantity from AssetActionSource, and Price from AssetActionSource TotalLineAmount. Uses filter-based update (not $Record) to avoid overwriting fields set by PopulateAssetLegacyFieldsAction (e.g. Hardware__c, Legacy_Id__c).</description>
        <name>Update_Asset_Legacy_Fields</name>
        <label>Update Asset Legacy Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Hardware__c</field>
            <value>
                <elementReference>varOrderItem.Hardware_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Legacy_Id__c</field>
            <value>
                <elementReference>varOrder.Legacy_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price</field>
            <value>
                <elementReference>varAssetActionSource.TotalLineAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity</field>
            <value>
                <elementReference>varAssetActionSource.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RenewalTerm</field>
            <value>
                <elementReference>varOrderItem.SubscriptionTerm</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RenewalTermUnit</field>
            <value>
                <elementReference>fmRenewalTermUnit</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Installed</stringValue>
            </value>
        </inputAssignments>
        <object>Asset</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HasLifecycleManagement</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Asset</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Asset_Action</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varAssetAction</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AssetAction</objectType>
    </variables>
    <variables>
        <name>varAssetActionSource</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AssetActionSource</objectType>
    </variables>
    <variables>
        <name>varOrder</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Order</objectType>
    </variables>
    <variables>
        <name>varOrderItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OrderItem</objectType>
    </variables>
</Flow>
