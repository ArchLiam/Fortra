        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Mulesoft_Sync_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
