    <decisions>
        <name>Data_Migration_User_Decision</name>
        <label>Data Migration User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No_Data_Migration_User_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dataMigrationUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Mulesoft_Sync_Status_to_Pending_Decision</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Set_Mulesoft_Sync_Status_to_Pending_Decision</name>
        <label>Set Mulesoft Sync Status to Pending?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Mulesoft_Sync_Status_to_Pending</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes - All Other Changes</defaultConnectorLabel>
        <rules>
            <name>No_Mulesoft_Fields_Outcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Mulesoft_Sync_Correlation_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Mulesoft_Sync_Message__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Mulesoft_Sync_Payload__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Mulesoft_Sync_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HubSpot_Contact_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Processing_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Form_Submission_Log_Details__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No - Mulesoft Fields</label>
        </rules>
        <rules>
            <name>No_Account_and_Contact_Fields_Outcome</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>No - Account and Contact Fields</label>
        </rules>
    </decisions>
    <description>2026-04-09: Adding bypass to data migration user</description>
    <environments>Default</environments>
    <formulas>
        <name>dataMigrationUser</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    OR(
        {!$User.Username} = &apos;data.migration@coastalcloud.us.db2&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.uat&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.fortraprod&apos;
    ),
    TRUE,
    FALSE
)</expression>
    </formulas>
    <interviewLabel>Lead | Before Insert/Update - Sync Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Inquiry | Before Insert/Update - Sync Status</label>
    <processMetadataValues>
