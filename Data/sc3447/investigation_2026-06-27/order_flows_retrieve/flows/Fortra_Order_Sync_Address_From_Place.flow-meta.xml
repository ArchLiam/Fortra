    <decisions>
        <name>Check_Ship_To_Also_Changed</name>
        <label>Check If Ship To Also Changed</label>
        <locationX>50</locationX>
        <locationY>710</locationY>
        <defaultConnectorLabel>Ship To Not Changed</defaultConnectorLabel>
        <rules>
            <name>Ship_To_Also_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Ship_To_Place__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Ship_To_Place__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Ship_To_Place_Details_After_Bill</targetReference>
            </connector>
            <label>Ship To Also Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Which_Place_Changed</name>
        <label>Check Which Place Changed</label>
        <locationX>182</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Get_Ship_To_Place_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ship_To_Place_Changed_Only</defaultConnectorLabel>
        <rules>
            <name>Bill_To_Place_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Bill_To_Place__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
