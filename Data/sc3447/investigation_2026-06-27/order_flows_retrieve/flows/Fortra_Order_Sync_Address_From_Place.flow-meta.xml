            </connector>
            <label>Bill To Place Changed</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Order that automatically re-populates BillingAddress or ShippingAddress when the user changes Bill_To_Place__c or Ship_To_Place__c on an existing Order. Only updates the specific address related to the changed Place field.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaBillingStreet</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Bill_To_Place_Details.Address__Street__s}), &quot;&quot;,
    {!Get_Bill_To_Place_Details.Address__Street__s} &amp;
    IF(ISBLANK({!Get_Bill_To_Place_Details.Street_Address_Line_2__c}), &quot;&quot;,
        BR() &amp; {!Get_Bill_To_Place_Details.Street_Address_Line_2__c}) &amp;
    IF(ISBLANK({!Get_Bill_To_Place_Details.Street_Address_Line_3__c}), &quot;&quot;,
        BR() &amp; {!Get_Bill_To_Place_Details.Street_Address_Line_3__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaShippingStreet</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Ship_To_Place_Details.Address__Street__s}), &quot;&quot;,
    {!Get_Ship_To_Place_Details.Address__Street__s} &amp;
    IF(ISBLANK({!Get_Ship_To_Place_Details.Street_Address_Line_2__c}), &quot;&quot;,
        BR() &amp; {!Get_Ship_To_Place_Details.Street_Address_Line_2__c}) &amp;
    IF(ISBLANK({!Get_Ship_To_Place_Details.Street_Address_Line_3__c}), &quot;&quot;,
        BR() &amp; {!Get_Ship_To_Place_Details.Street_Address_Line_3__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaShippingStreetAfterBill</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Ship_To_Place_Details_After_Bill.Address__Street__s}), &quot;&quot;,
    {!Get_Ship_To_Place_Details_After_Bill.Address__Street__s} &amp;
    IF(ISBLANK({!Get_Ship_To_Place_Details_After_Bill.Street_Address_Line_2__c}), &quot;&quot;,
        BR() &amp; {!Get_Ship_To_Place_Details_After_Bill.Street_Address_Line_2__c}) &amp;
    IF(ISBLANK({!Get_Ship_To_Place_Details_After_Bill.Street_Address_Line_3__c}), &quot;&quot;,
        BR() &amp; {!Get_Ship_To_Place_Details_After_Bill.Street_Address_Line_3__c})
)</expression>
    </formulas>
