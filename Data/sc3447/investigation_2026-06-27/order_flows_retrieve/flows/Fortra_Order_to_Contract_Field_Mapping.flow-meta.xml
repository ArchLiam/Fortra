<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Map_Custom_Fields</name>
        <label>Map Custom Fields from Order</label>
        <locationX>143</locationX>
        <locationY>708</locationY>
        <assignmentItems>
            <assignToReference>Contract_To_Update.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contract_To_Update.Partner__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Order.Partner_Account__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contract_To_Update.Deal_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Quote.Deal_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contract_To_Update.Legal_Entity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Quote.LegalEntityId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contract</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Source_Order_Found</name>
        <label>Check Source Order Found</label>
        <locationX>473</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>No Source Order</defaultConnectorLabel>
        <rules>
            <name>Source_Order_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source_Order</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Source_Quote</targetReference>
            </connector>
            <label>Source Order Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Source_Quote_Found</name>
        <label>Check Source Quote Found</label>
        <locationX>275</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>No Source Quote</defaultConnectorLabel>
        <rules>
            <name>Source_Quote_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source_Quote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Map_Custom_Fields</targetReference>
            </connector>
            <label>Source Quote Found</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Contract (After Save) that maps Fortra-specific custom fields from Order and Quote when a Contract is created from Order conversion. Supplements the standard RCA ContractsContextDefinition mappings with custom field mappings: Partner (from Order), Deal Type and Legal Entity (from Quote).</description>
    <environments>Default</environments>
    <interviewLabel>Fortra Order to Contract Field Mapping {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Order | Order to Contract Field Mapping</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Source_Order</name>
        <label>Get Source Order</label>
        <locationX>473</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Source_Order_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SourceOrderId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_Quote</name>
        <label>Get Source Quote from Order</label>
        <locationX>275</locationX>
        <locationY>492</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Source_Quote_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Source_Order.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>LegalEntityId</queriedFields>
        <queriedFields>Deal_Type__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contract</name>
        <label>Update Contract with Custom Fields</label>
        <locationX>143</locationX>
        <locationY>816</locationY>
        <inputReference>Contract_To_Update</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SourceOrderId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contract</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Run_After_Creation</name>
            <connector>
                <targetReference>Get_Source_Order</targetReference>
            </connector>
            <label>Run After Creation</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Contract_To_Update</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contract</objectType>
    </variables>
</Flow>
