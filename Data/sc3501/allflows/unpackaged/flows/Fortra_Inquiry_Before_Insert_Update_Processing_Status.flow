<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Processing_Status_to_Ready_for_Assignment</name>
        <label>Set Processing Status to Ready for Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Processing_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Ready for Assignment</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Account_Enriched_Decision</name>
        <label>Account Enriched?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_Enrinched_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__r.DB_Enriched__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enriched</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Processing_Status_to_Ready_for_Assignment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>2026-04-24: Adding &quot;Is Changed&quot; criteria on user editable fields</description>
    <environments>Default</environments>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Fortra | Inquiry | Before Insert/Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Inquiry | Before Insert/Update - Processing Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Account_Enriched_Decision</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3 AND 4 AND 5 AND 6) AND (7 OR 8 OR 9)</filterLogic>
        <filters>
            <field>Processing_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Ready for Assignment</stringValue>
            </value>
        </filters>
        <filters>
            <field>Processing_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Assignment Successful</stringValue>
            </value>
        </filters>
        <filters>
            <field>Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Product_of_Interest__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Actionable__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Actionable__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Account__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Contact__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
