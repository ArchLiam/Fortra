<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Quote_Line_Item</name>
        <label>Build Quote Line Item</label>
        <locationX>138</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>Current_QLI.QuoteId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>New_Quote_Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Current_QLI.Product2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contract_Line_Items.Product2Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Current_QLI.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contract_Line_Items.Quantity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Current_QLI.UnitPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contract_Line_Items.UnitPrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Current_QLI.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contract_Line_Items.Description</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Current_QLI.Pre_COLA_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contract_Line_Items.UnitPrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineItems_To_Create</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Current_QLI</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contract_Line_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Contract_Found</name>
        <label>Check Contract Found</label>
        <locationX>336</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_No_Contract</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contract Not Found</defaultConnectorLabel>
        <rules>
            <name>Contract_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source_Contract</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contract_Line_Items</targetReference>
            </connector>
            <label>Contract Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Line_Items_Found</name>
        <label>Check Line Items Found</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Update_Contract_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Line Items</defaultConnectorLabel>
        <rules>
            <name>Line_Items_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_Line_Items</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Contract_Line_Items</targetReference>
            </connector>
            <label>Line Items Found</label>
        </rules>
    </decisions>
    <description>Screen Flow launched from the Renew button on Contract. Creates a renewal Quote with Quote_Type__c = Renewal, copies Account, Currency, Legal Entity, Solution Group from Contract, creates Quote Line Items from Contract Line Items (with COLA applied via COLAUpliftHandler trigger), and updates Contract Renewal_Status__c to In Progress.</description>
    <environments>Default</environments>
    <formulas>
        <name>QuoteName_Formula</name>
        <dataType>String</dataType>
        <expression>{!Get_Source_Contract.ContractNumber} &amp; &quot; - Renewal&quot;</expression>
    </formulas>
    <interviewLabel>Fortra Renewal Quote Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Screen Flow - Renewal Quote Creation</label>
    <loops>
        <name>Loop_Contract_Line_Items</name>
        <label>Loop Contract Line Items</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <collectionReference>Get_Contract_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Quote_Line_Item</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Quote_Line_Items</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Quote_Line_Items</name>
        <label>Create Quote Line Items</label>
        <locationX>50</locationX>
        <locationY>974</locationY>
        <connector>
            <targetReference>Update_Contract_Status</targetReference>
        </connector>
        <inputReference>QuoteLineItems_To_Create</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Renewal_Quote</name>
        <label>Create Renewal Quote</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <assignRecordIdToReference>New_Quote_Id</assignRecordIdToReference>
        <connector>
            <targetReference>Check_Line_Items_Found</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Get_Source_Contract.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>Get_Source_Contract.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LegalEntityId</field>
            <value>
                <elementReference>Get_Source_Contract.Legal_Entity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>QuoteName_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quote_Type__c</field>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Renewal_Contract__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Contract_Line_Items</name>
        <label>Get Contract Line Items</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Renewal_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ServiceContractId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContractLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_Contract</name>
        <label>Get Source Contract</label>
        <locationX>336</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Contract_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contract_Status</name>
        <label>Update Contract Status to In Progress</label>
        <locationX>182</locationX>
        <locationY>1166</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Renewal_Status__c</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <screens>
        <name>Error_Screen_No_Contract</name>
        <label>Error - Contract Not Found</label>
        <locationX>490</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message_No_Contract</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(194, 57, 52); background-color: rgb(255, 255, 255);&quot;&gt;Error: Unable to find the source Contract. Please contact your administrator.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Renewal Quote Created</label>
        <locationX>182</locationX>
        <locationY>1274</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Message</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(46, 125, 50); background-color: rgb(255, 255, 255);&quot;&gt;Renewal Quote created successfully!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Quote ID: {!New_Quote_Id}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The Contract Renewal Status has been updated to In Progress.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;COLA pricing will be automatically applied to the Quote Line Items via the COLAUpliftHandler.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>210</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Source_Contract</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>Current_QLI</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
    <variables>
        <name>New_Quote_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>QuoteLineItems_To_Create</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
    <variables>
        <description>Contract record ID passed from the Renew button</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
