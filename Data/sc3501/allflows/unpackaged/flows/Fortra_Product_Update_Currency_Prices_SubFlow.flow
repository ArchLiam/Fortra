<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Call_Apex_Update_Prices</name>
        <label>Call Apex: Update Pricebook Entry Prices</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <actionName>UpdatePricebookEntriesInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Calculate_Total_Count</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>product2Id</name>
            <value>
                <elementReference>varProduct2Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>pricebook2Id</name>
            <value>
                <elementReference>varPricebook2Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>currencyIsoCodes</name>
            <value>
                <elementReference>colCurrencyIsoCodes</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>unitPrices</name>
            <value>
                <elementReference>colUnitPrices</elementReference>
            </value>
        </inputParameters>
        <nameSegment>UpdatePricebookEntriesInvocable</nameSegment>
        <outputParameters>
            <assignToReference>varUpdatedCount</assignToReference>
            <name>updatedCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCreatedCount</assignToReference>
            <name>createdCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varApexSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varApexErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Currency_Price_Update</name>
        <label>Build Currency Price Lists</label>
        <locationX>440</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>colCurrencyIsoCodes</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>curFormula.Currency_ISO_Code__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colUnitPrices</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Formula_Calculate_Currency_Price</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Currencies</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Calculate_Total_Count</name>
        <label>Calculate Total Count</label>
        <locationX>176</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>varCreatedCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Formula_Total_Count</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Valid_Currency</name>
        <label>Check Valid Currency</label>
        <locationX>440</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Build_Currency_Price_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valid</defaultConnectorLabel>
        <rules>
            <name>Skip_Currency</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>curFormula.Label</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>curFormula.Currency_ISO_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Currencies</targetReference>
            </connector>
            <label>Skip Currency</label>
        </rules>
    </decisions>
    <description>Sub-flow to update/create multi-currency pricebook entries using Apex invocable action</description>
    <formulas>
        <name>Formula_Calculate_Currency_Price</name>
        <dataType>Number</dataType>
        <expression>{!varUSD_Base_Price} * VALUE(TRIM(SUBSTITUTE({!curFormula.Conversion_Formula__c}, &quot;*&quot;, &quot;&quot;)))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Formula_Total_Count</name>
        <dataType>Number</dataType>
        <expression>{!varUpdatedCount} + {!varCreatedCount}</expression>
        <scale>0</scale>
    </formulas>
    <label>Fortra | Product | Update Currency Prices SubFlow</label>
    <loops>
        <name>Loop_Through_Currencies</name>
        <label>Loop Through Currencies</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNextValueToReference>curFormula</assignNextValueToReference>
        <collectionReference>colCurrencyFormulas</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Valid_Currency</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Call_Apex_Update_Prices</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Currency_Formulas</name>
        <label>Get Currency Formulas</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Currencies</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Currency_Conversion_Formula__mdt</object>
        <outputReference>colCurrencyFormulas</outputReference>
        <queriedFields>Label</queriedFields>
        <queriedFields>Currency_ISO_Code__c</queriedFields>
        <queriedFields>Conversion_Formula__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Currency_Formulas</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>colCurrencyFormulas</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Currency_Conversion_Formula__mdt</objectType>
    </variables>
    <variables>
        <name>colCurrencyIsoCodes</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>colUnitPrices</name>
        <dataType>Number</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>curFormula</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Currency_Conversion_Formula__mdt</objectType>
    </variables>
    <variables>
        <name>varApexErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varApexSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCreatedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varPricebook2Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varProduct2Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varUpdatedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varUSD_Base_Price</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
