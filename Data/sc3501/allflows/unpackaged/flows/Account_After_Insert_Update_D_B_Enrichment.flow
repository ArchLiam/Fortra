<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Callout_and_Perform_Enrichment</name>
        <label>Callout and Perform Enrichment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>DunAndBradstreetHandler</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Loop_Results</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Enrichment_Failed_for_Triggered_Account</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>account</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>DunAndBradstreetHandler</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Enrichment_Failed_for_Returned_Account</name>
        <label>Set Enrichment Failed for Returned Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Results.DB_Enriched__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Failed Enrichment</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>accountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Results</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Results</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Enrichment_Failed_for_Triggered_Account</name>
        <label>Set Enrichment Failed for Triggered Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.DB_Enriched__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Failed Enrichment</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>accountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Accounts_to_Update_Decision</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Account_Enriched_Decision</name>
        <label>Account Enriched?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Results</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Account_Enriched_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Results.DB_Enriched__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Enriched</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Enrichment_Failed_for_Returned_Account</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Accounts_to_Update_Decision</name>
        <label>Accounts to Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Accounts_to_Update_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>accountsToUpdate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Accounts</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Data_Migration_User_Decision</name>
        <label>Data Migration User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No_Data_Migration_User_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dataMigrationUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Callout_and_Perform_Enrichment</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>2026-04-09: Adding bypass to data migration user</description>
    <environments>Default</environments>
    <formulas>
        <name>dataMigrationUser</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    OR(
        {!$User.Username} = &apos;data.migration@coastalcloud.us.db2&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.uat&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.fortraprod&apos;
    ),
    TRUE,
    FALSE
)</expression>
    </formulas>
    <interviewLabel>Account | After Insert/Update - D&amp;B Enrichment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Account | After Insert/Update - D&amp;B Enrichment</label>
    <loops>
        <name>Loop_Results</name>
        <label>Loop Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Callout_and_Perform_Enrichment</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Account_Enriched_Decision</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Accounts_to_Update_Decision</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Accounts</name>
        <label>Update Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>accountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DB_Enriched__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Not Enriched</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Data_Migration_User_Decision</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>accountsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
