    <recordLookups>
        <name>Get_related_Duplicate_TC_Issues</name>
        <label>Get related Duplicate TC Issues</label>
        <locationX>519</locationX>
        <locationY>374</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Other_Open_Test_Case_Issues_Found</targetReference>
        </connector>
        <filterLogic>(1 AND 6 AND (2 OR 3 OR 4 OR 5))</filterLogic>
        <filters>
            <field>Duplicate_Of__c</field>
            <operator>EqualTo</operator>
            <value>
