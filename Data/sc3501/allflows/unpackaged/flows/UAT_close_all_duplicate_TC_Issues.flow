    <decisions>
        <name>Other_Open_Test_Case_Issues_Found</name>
        <label>Other Open Test Case Issues Found?</label>
        <locationX>514</locationX>
        <locationY>544</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DuplicateCollectionofIssues</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Feedback_Enhancement_Request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
