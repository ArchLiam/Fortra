<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Give_Contact_Fortra_Academy_Access_Approved</name>
        <label>Give Contact Fortra Academy Access (Approved)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>PortalUserManagementHelper</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contactIds</name>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PortalUserManagementHelper</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Give_Contact_Fortra_Academy_Access_Existing</name>
        <label>Give Contact Fortra Academy Access (Existing)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>PortalUserManagementHelper</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contactIds</name>
            <value>
                <elementReference>$Record.ContactId</elementReference>
