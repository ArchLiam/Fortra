    <decisions>
        <name>Check_Estimate_Product_Instance_Billing_Type</name>
        <label>Check Estimate Product Instance Billing Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Estimate_Product_Instance_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Time_Materials_T_M</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Estimate_Product_Instance_Records.ffscpq__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Time and Materials</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_T_M_Milestone_Data</targetReference>
            </connector>
            <label>Time &amp; Materials (T&amp;M)</label>
        </rules>
        <rules>
            <name>Fixed_Price_FP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Estimate_Product_Instance_Records.ffscpq__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed Price</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Fixed_Price_Billing_Frequency</targetReference>
            </connector>
            <label>Fixed Price (FP)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Is_service_Product</name>
        <label>Check for Is service Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Recurring_Quote_lines_for_budget</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Fail</defaultConnectorLabel>
        <rules>
            <name>Check_Pass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Recurring_Quote_lines_for_budget.Product2.pse__IsServicesProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Recurring_Quote_lines_for_budget.TotalPrice</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recurring_Budget_Amount</targetReference>
            </connector>
            <label>Check Pass</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Quote_line_Product_for_is_service_and_reccuring</name>
        <label>Check for Quote line Product for is service and reccuring?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Quote_Lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recurring1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Quote_Lines.Product2.Is_Recurring_Service__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Quote_Lines.Unique_Product_Identifier__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recurring_Quote_Line_Collection</targetReference>
            </connector>
            <label>Recurring1</label>
        </rules>
        <rules>
            <name>Non_Reccuring1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsRecurring</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Quote_Lines.Unique_Product_Identifier__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Non_recurring_Quote_Line_Collection</targetReference>
            </connector>
            <label>Non Reccuring1</label>
        </rules>
    </decisions>
