        </rules>
        <rules>
            <name>Found_Earlier_Date2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Recurring_QLIs_for_date.Effective_End_Date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Recurring_Max_End_date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Max_Date2</targetReference>
            </connector>
            <label>Found Earlier Date2</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Minimum_date</name>
        <label>Check Minimum date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_max_date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>Set_Initial_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recurring_min_start_date</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Date1</targetReference>
            </connector>
            <label>Set Initial Date</label>
        </rules>
        <rules>
            <name>Found_Earlier_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Recurring_QLIs_for_date.EffectiveDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Recurring_min_start_date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Date2</targetReference>
            </connector>
            <label>Found Earlier Date</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_we_get_a_Syncing_Quote_on_the_opportunity</name>
        <label>Did we get a Syncing Quote on the opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Quote_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Is_Syncing.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Lines</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_we_get_estimate_product_instance_records</name>
        <label>Did we get estimate product instance records?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Estimate_Product_Instance_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Convert_EPI_Record_IDs_to_Text</targetReference>
            </connector>
            <label>Yes3</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_we_get_Quote_Lines</name>
        <label>Did we get Quote Lines?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Project_Template_NonRecurring_Services</targetReference>
            </connector>
            <label>Yes2</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_we_get_records_for_Quote_line_collection</name>
        <label>Did we get records for Quote line collection?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>NO Quote Line Items were collected.</defaultConnectorLabel>
        <rules>
            <name>Yes_QLI_Available_for_Recurring</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Collection_recurring_quote_lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_Recurring_QLIs_for_date</targetReference>
            </connector>
            <label>Yes QLI Available for Recurring</label>
        </rules>
        <rules>
            <name>Yes_QLI_Available_for_Non_Recurring</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Collection_non_recurring_quote_lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Values_Project_Non_Recurring</targetReference>
            </connector>
            <label>Yes QLI Available for Non Recurring</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Fortra_region_have_a_value</name>
        <label>Does Fortra region have a value?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Quote_Is_Syncing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Ship_To_Place__r.Fortra_Region__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Fortra_Region</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <description>Branch PSA Updates</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ProjectEndDate_Non_Recurring</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CloseDate} + 364</expression>
    </formulas>
    <formulas>
        <name>f_ProjectName_Non_recurring</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Name} + &quot; - Non Rec Project&quot;, 80)</expression>
    </formulas>
    <formulas>
        <name>fBudget_Allocation_Name_Non_reccuring</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_Project_Non_recurring_shell.Name}, 65) + &quot; - Budget Alloc&quot;</expression>
    </formulas>
    <formulas>
        <name>fBudget_allocation_recurring_name</name>
        <dataType>String</dataType>
        <expression>LEFT({!varProjectShell.Name}, 65) + &quot; - Budget Alloc&quot;</expression>
    </formulas>
    <formulas>
        <name>fBudgetName_Non_recurring</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_Project_Non_recurring_shell.Name} + &quot; - Budget&quot;, 80)</expression>
    </formulas>
    <formulas>
        <name>fMilestone_Non_recurring_target_date</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CloseDate} + 364</expression>
    </formulas>
    <formulas>
        <name>IsRecurring</name>
        <dataType>Boolean</dataType>
        <expression>{!Loop_through_Quote_Lines.Product2.Is_Recurring_Service__c}</expression>
    </formulas>
    <formulas>
        <name>Milestone_Billing_type_Non_recurring</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_through_Non_recurring_QLIs.Postpaid_Service__c} = TRUE, &quot;Postpaid&quot;,&quot;Prepaid&quot;)</expression>
    </formulas>
    <formulas>
        <name>Milestone_Billing_Type_recurring</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_through_Recurring_Quote_lines.Postpaid_Service__c} = TRUE, &quot;Postpaid&quot;,&quot;Prepaid&quot;)</expression>
    </formulas>
    <formulas>
        <name>Non_recurring_milestone_planned_hours</name>
        <dataType>Number</dataType>
        <expression>{!currentItem_Non_Recurring_Milestone_Filtered_Record.pse__Planned_Hours__c}*{!Loop_through_Non_recurring_QLIs.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Project_Name_estimate</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &apos; - Project&apos;</expression>
    </formulas>
    <formulas>
        <name>Recurring_milestone_planned_hours</name>
        <dataType>Number</dataType>
        <expression>{!currentItem_Recurring_Milestones_filtered_collection.pse__Planned_Hours__c}*{!Loop_through_Recurring_Quote_lines.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Recurring_Proj_region</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(
{!var_Project_region_recurring_fortra},
{!Get_Global_Region.Id}
)</expression>
    </formulas>
    <formulas>
        <name>Recurring_Project_name</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Name} + &quot; - Recurring Project&quot;, 80)</expression>
    </formulas>
    <formulas>
        <name>var_recurring_budget_name</name>
        <dataType>String</dataType>
        <expression>LEFT({!varProjectShell.Name} + &quot; - Budget&quot;, 80)</expression>
    </formulas>
