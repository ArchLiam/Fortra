<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_values_OpportunityPartnersRecord_Distributor</name>
        <label>Assign values OpportunityPartnersRecord Ditributor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Partner_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Distributor__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Partner_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Distributor</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OpportunityPartnerNameFormulaforDistributor</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>OpportunityPartnersRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_New_Opportunity_Partners</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_values_OpportunityPartnersRecord_Reseller</name>
        <label>Assign values OpportunityPartnersRecord Reseller</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Partner_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Reseller__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Partner_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reseller</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersRecord.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OpportunityPartnerNameFormulaforReseller</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityPartnersCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>OpportunityPartnersRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Distributor_Decision</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Distributor_Decision</name>
        <label>Distributor Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_New_Opportunity_Partners</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Distributor</defaultConnectorLabel>
        <rules>
            <name>YES_Distributor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_values_OpportunityPartnersRecord_Distributor</targetReference>
            </connector>
            <label>YES Distributor</label>
        </rules>
    </decisions>
    <decisions>
        <name>Exclude_Data_Migration_User</name>
        <label>Exclude Data Migration User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Running IS Data Migration User</defaultConnectorLabel>
        <rules>
            <name>NOT_Data_Migration_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Data_Migration_Exclude_Business_Logic</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reseller_Decision_0</targetReference>
            </connector>
            <label>NOT Data Migration User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reseller_Decision_0</name>
        <label>Reseller Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Distributor_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Reseller</defaultConnectorLabel>
        <rules>
            <name>YES_Reseller_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reseller__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_values_OpportunityPartnersRecord_Reseller</targetReference>
            </connector>
            <label>YES Reseller</label>
        </rules>
    </decisions>
    <description>Flow Label</description>
    <environments>Default</environments>
    <formulas>
        <name>OpportunityPartnerNameFormulaforDistributor</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name}&amp;&apos; Distributor Partner&apos;</expression>
    </formulas>
    <formulas>
        <name>OpportunityPartnerNameFormulaforReseller</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name}&amp;&apos; Reseller Partner&apos;</expression>
    </formulas>
    <interviewLabel>Opportunity | Create - Opportunity Partners Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra |  Opportunity | After Insert - Opportunity Partners Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_New_Opportunity_Partners</name>
        <label>Create New Opportunity Partners</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>OpportunityPartnersCollection</inputReference>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Exclude_Data_Migration_User</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Reseller__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Distributor__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>OpportunityPartnersCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Opportunity_Partners__c</objectType>
    </variables>
    <variables>
        <name>OpportunityPartnersRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Opportunity_Partners__c</objectType>
    </variables>
</Flow>
