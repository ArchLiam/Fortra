<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>D-18 subscriber. Persists each Pricing_Exception__e platform event to a durable Exception_Log__c row (RecordType &quot;Pricing Exception&quot;). Runs in its own async transaction, so it never rolls back with a failed pricing reprice and consumes no pricing-transaction DML. See docs/pricing-refactor/D18_TELEMETRY_DESIGN.md.</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Pricing | Exception Logger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Pricing | Exception Logger</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Exception_Log</name>
        <label>Create Exception Log</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Context_Id__c</field>
            <value>
                <elementReference>$Record.Context_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exception_Type__c</field>
            <value>
                <elementReference>$Record.Exception_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Hook_Phase__c</field>
            <value>
                <elementReference>$Record.Hook_Phase__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <elementReference>$Record.Message__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Occurred_At__c</field>
            <value>
                <elementReference>$Record.Occurred_At__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Pricing_Exception_RT.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity__c</field>
            <value>
                <elementReference>$Record.Severity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <elementReference>$Record.Source__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stack_Trace__c</field>
            <value>
                <elementReference>$Record.Stack_Trace__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transaction_Id__c</field>
            <value>
                <elementReference>$Record.Transaction_Id__c</elementReference>
            </value>
        </inputAssignments>
        <object>Exception_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Pricing_Exception_RT</name>
        <label>Get Pricing Exception Record Type</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Exception_Log</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Exception_Log__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pricing_Exception</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Pricing_Exception_RT</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>Pricing_Exception__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
</Flow>
