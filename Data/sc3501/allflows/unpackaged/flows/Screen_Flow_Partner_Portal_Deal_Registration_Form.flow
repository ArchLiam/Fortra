    <formulas>
        <description>Use to set the close date 30 days out from today</description>
        <name>CloseDate30daysfromtoday</name>
        <dataType>Date</dataType>
        <expression>TODAY()+30</expression>
    </formulas>
    <formulas>
        <name>ExistingorNewContactId</name>
        <dataType>String</dataType>
        <expression>IF(
NOT(ISNULL({!Get_Contacts_with_Matching_Email.Id})),
{!Get_Contacts_with_Matching_Email.Id},
{!Create_Contact_based_on_Deal_Registration.Id}
)</expression>
    </formulas>
    <formulas>
        <description>{Customer Account Name} {Unit} Deal - Registered by {Partner Account Name}</description>
        <name>NewOpportunityNameFormula</name>
        <dataType>String</dataType>
        <expression>{!Customer_Company_Name}&amp;&quot;  &quot;&amp;{!Product_Unit}&amp;&quot; Deal - Registered by &quot;&amp;{!Get_Users_Contact_Information.Account.Name}</expression>
    </formulas>
    <formulas>
        <name>ProductChoiceValueSelectionTechorCyber</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!CyberProductsChoiceLookup.selectedChoiceValues})),
    {!CyberProductsChoiceLookup.selectedChoiceValues},
    {!TechProductsChoiceLookup.selectedChoiceValues}
)</expression>
    </formulas>
    <formulas>
        <name>ResellerRequiredorNotRequiredrecordIdFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISNULL({!Reseller_Company_Name.recordId})),
   {!Reseller_Company_Name.recordId},
    IF(
        NOT(ISNULL({!Reseller_Company_Name_Required.recordId})),
        {!Reseller_Company_Name_Required.recordId},
        &quot;&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>validateWebsiteInput</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(TRIM({!Account_Website_Text}), &quot;^(https?://)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-z]{2,6}/?$&quot;)</expression>
    </formulas>
    <interviewLabel>Screen Flow Deal - Partner Portal - Deal Registration Form {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Screen Flow - Partner Portal Deal Registration Form</label>
    <loops>
