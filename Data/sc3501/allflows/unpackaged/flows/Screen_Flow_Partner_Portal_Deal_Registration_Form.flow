    <decisions>
        <name>Contact_Match_Found</name>
        <label>Contact Match Found?</label>
        <locationX>610</locationX>
        <locationY>1983</locationY>
        <defaultConnector>
            <targetReference>Create_Contact_based_on_Deal_Registration</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO Contact Match Found</defaultConnectorLabel>
        <rules>
            <name>YES_Contact_Match_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacts_with_Matching_Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NewOpportunity_values</targetReference>
            </connector>
            <label>YES Contact Match Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>How_many_records_in_DUNS_Callout_Accounts</name>
        <label>How many records in DUNS Callout Accounts?</label>
        <locationX>1097</locationX>
        <locationY>699</locationY>
        <defaultConnector>
            <targetReference>DB_found_Accounts_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Only 1</defaultConnectorLabel>
        <rules>
            <name>No_Results</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>COUNTAccountCollection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NoAccountSelected_Error_Screen</targetReference>
            </connector>
            <label>No Results</label>
        </rules>
        <rules>
            <name>More_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>COUNTAccountCollection</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DB_found_Accounts_Screen</targetReference>
            </connector>
            <label>More than 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_was_changed</name>
        <label>Owner was changed?</label>
        <locationX>595</locationX>
        <locationY>3232</locationY>
        <defaultConnector>
            <targetReference>Success_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Owner NOT Changed</defaultConnectorLabel>
        <rules>
            <name>YES_OwnerChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opportunity_Owner_and_Team_Member_Assignment.ownerChangeFlag</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_Opportunity_for_Approval</targetReference>
            </connector>
            <label>YES OwnerChanged</label>
        </rules>
    </decisions>
    <decisions>
        <name>Selected_Account_New_or_Existing</name>
        <label>Selected Account- New or Existing?</label>
        <locationX>1580</locationX>
        <locationY>1304</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Selected_Account_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DBfoundAccounts_DataTable.selectedRows</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DBfoundAccounts_DataTable.firstSelectedRow.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Selected_Account</targetReference>
            </connector>
            <label>Selected Account - New</label>
        </rules>
        <rules>
            <name>Selected_Account_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DBfoundAccounts_DataTable.selectedRows</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DBfoundAccounts_DataTable.firstSelectedRow.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Selected_Account_to_AccountId</targetReference>
            </connector>
            <label>Selected Account - Existing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Unit_Selection</name>
        <label>Unit Selection</label>
        <locationX>600</locationX>
        <locationY>1096</locationY>
        <defaultConnector>
            <targetReference>Get_Tech_Marketing_Products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unit Selection is Tech</defaultConnectorLabel>
        <rules>
            <name>Unit_Selection_is_Cyber</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Product_Unit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Cyber</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cyber_Marketing_Products</targetReference>
            </connector>
            <label>Unit Selection is Cyber</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_selection_is_NULL</name>
        <label>Which selection is NULL?</label>
        <locationX>1264</locationX>
        <locationY>1668</locationY>
        <defaultConnector>
            <targetReference>Parse_Multipicklist_Selection_Cyber</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>TechProductsChoiceLookup_null</defaultConnectorLabel>
        <rules>
            <name>CyberProductsChoiceLookup_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CyberProductsChoiceLookup.selectedChoiceValues</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Parse_Multipicklist_Selection_Tech</targetReference>
            </connector>
            <label>CyberProductsChoiceLookup_null</label>
        </rules>
    </decisions>
    <description>2026-04-10: Fix Deal Origin assignment 
2026-03-24: Add individual Billing Address fields on results screen.
2026-03-12: Switched website input from URL to Text with a custom validation formula.
2026-03-09: Changing to System Context with Sharing
2026-03-03: Adding fault path to approval submission action
2026-02-26: Making sure state code is added to AccountRecord
SC-2408 Bugfixing/Enhancements</description>
