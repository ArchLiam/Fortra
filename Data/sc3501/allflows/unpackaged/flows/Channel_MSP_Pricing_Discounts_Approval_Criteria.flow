            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_QLI</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_QLI_to_Collection_Variable_21_50</name>
        <label>Assign QLI to Collection Variable 21-50</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ColVarQLIs21To50Discount</assignToReference>
