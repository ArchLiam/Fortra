<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_QLI_to_Collection_Variable_16_20</name>
        <label>Assign QLI to Collection Variable 16-20</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ColVarQLIs16To20Discount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_QLI</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_QLI</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_QLI_to_Collection_Variable_1_25</name>
        <label>Assign QLI to Collection Variable 1-25</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ColVarQLIs1To15Discount</assignToReference>
            <operator>Add</operator>
            <value>
