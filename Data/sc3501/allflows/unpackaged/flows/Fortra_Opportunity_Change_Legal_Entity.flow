<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Choice_Cancel</name>
        <choiceText>Cancel - keep current Legal Entity</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Cancel</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Delete_Quotes</name>
        <choiceText>Delete all Quotes and change Legal Entity + Currency</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Delete</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_Currency_Change_Needed</name>
        <label>Currency Change Needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Has_Quotes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Currency Change Needed</defaultConnectorLabel>
        <rules>
            <name>Keep_Current_Currency</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSelectedCurrency</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>formulaOppCurrency</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_LE_Only</targetReference>
            </connector>
            <label>Keep Current Currency</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Current_Currency_Supported</name>
        <label>New LE Supports Current Currency?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Cannot_Change_Currency</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Supported</defaultConnectorLabel>
        <rules>
            <name>Currency_Is_Supported</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Currency_In_LE</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_LE_Only</targetReference>
            </connector>
            <label>Currency Is Supported</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Has_Blocking_Records</name>
        <label>Has Blocking Related Records?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Select_Currency</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Blockers</defaultConnectorLabel>
        <rules>
            <name>Has_Blockers</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Products</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Orders</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Currency_In_LE</targetReference>
            </connector>
            <label>Has Blockers</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Has_Quotes</name>
        <label>Has Quotes?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Confirm_Delete_Quotes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Quotes</defaultConnectorLabel>
        <rules>
            <name>No_Quotes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Quote_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_LE_And_Currency</targetReference>
            </connector>
            <label>No Quotes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Same_Legal_Entity</name>
        <label>Same Legal Entity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Related_Products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different LE Selected</defaultConnectorLabel>
        <rules>
            <name>Same_LE_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>selectedNewLegalEntity.recordId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity.Legal_Entity__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_No_Change_Needed</targetReference>
            </connector>
            <label>Same LE Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_User_Decision</name>
        <label>User Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>User_Chose_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUserDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delete</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Synced_Quote</targetReference>
            </connector>
            <label>Delete Quotes</label>
        </rules>
    </decisions>
    <description>Screen Flow Quick Action that guides users through changing an Opportunity Legal Entity. User picks a new LE; the flow then checks for OLI/Order blockers. If blockers exist, the flow skips the currency picker and either silently keeps the current currency (if supported by the new LE) or shows a Cannot Change Currency screen. If no blockers, the flow shows a CMDT-driven currency picker (Legal_Entity_Currency__mdt) letting the user pick from the allowed currencies. Uses LE_Change_In_Progress__c bypass flag to coordinate with Legal_Entity_Requires_Action validation rule.</description>
    <dynamicChoiceSets>
        <name>Currency_Options</name>
        <dataType>String</dataType>
        <displayField>Currency_Code__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Legal_Entity_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_New_Legal_Entity.Name</elementReference>
            </value>
        </filters>
        <object>Legal_Entity_Currency__mdt</object>
        <sortField>Is_Primary__c</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Currency_Code__c</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>formulaBlockerWarning</name>
        <dataType>String</dataType>
        <expression>&quot;This Opportunity has related Products or Orders in &quot; &amp; TEXT({!Get_Opportunity.CurrencyIsoCode}) &amp; &quot;, which anchors the Opportunity currency. The new Legal Entity (&quot; &amp; {!Get_New_Legal_Entity.Name} &amp; &quot;) does not support &quot; &amp; TEXT({!Get_Opportunity.CurrencyIsoCode}) &amp; &quot;, so you cannot switch to this Legal Entity.&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaCurrencyPickerHeader</name>
        <dataType>String</dataType>
        <expression>&quot;Select a currency for this Opportunity on the new Legal Entity: &quot; &amp; {!Get_New_Legal_Entity.Name} &amp; &quot;. The Opportunity currently uses &quot; &amp; TEXT({!Get_Opportunity.CurrencyIsoCode}) &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaCurrentInfo</name>
        <dataType>String</dataType>
        <expression>&quot;Current Legal Entity: &quot; &amp; {!Get_Opportunity.Legal_Entity__r.Name} &amp; &quot; (&quot; &amp; TEXT({!Get_Opportunity.CurrencyIsoCode}) &amp; &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaFinalCurrency</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varSelectedCurrency}), TEXT({!Get_Opportunity.CurrencyIsoCode}), {!varSelectedCurrency})</expression>
    </formulas>
    <formulas>
        <name>formulaOppCurrency</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Opportunity.CurrencyIsoCode})</expression>
    </formulas>
    <formulas>
        <name>formulaQuoteWarning</name>
        <dataType>String</dataType>
        <expression>&quot;This Opportunity has &quot; &amp; TEXT({!Get_Opportunity.Quote_Count__c}) &amp; &quot; Quote(s). Changing currency from &quot; &amp; TEXT({!Get_Opportunity.CurrencyIsoCode}) &amp; &quot; to &quot; &amp; {!varSelectedCurrency} &amp; &quot; requires all Quotes to be deleted first.&quot;</expression>
    </formulas>
    <interviewLabel>Fortra | Opportunity | Change Legal Entity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Opportunity | Change Legal Entity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordDeletes>
        <name>Delete_All_Quotes</name>
        <label>Delete All Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Quote_Count_Zero</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Quote</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_Current_Currency_In_LE</name>
        <label>Get Current Currency In New LE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Current_Currency_Supported</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Legal_Entity_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_New_Legal_Entity.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Currency_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formulaOppCurrency</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Legal_Entity_Currency__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Legal_Entity</name>
        <label>Get New Legal Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Same_Legal_Entity</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>selectedNewLegalEntity.recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LegalEntity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Select_Legal_Entity</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Orders</name>
        <label>Get Related Orders</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Has_Blocking_Records</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Products</name>
        <label>Get Related Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Related_Orders</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Clear_Synced_Quote</name>
        <label>Clear Opportunity Synced Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Delete_All_Quotes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SyncedQuoteId</field>
            <value>
                <elementReference>varNullId</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reset_LE_Change_In_Progress</name>
        <label>Reset LE Change In Progress Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>LE_Change_In_Progress__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Quote_Count_Zero</name>
        <label>Set Quote Count to Zero</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Opp_LE_And_Currency</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Quote_Count__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp_LE_And_Currency</name>
        <label>Update Opportunity - LE and Currency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reset_LE_Change_In_Progress</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>varSelectedCurrency</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LE_Change_In_Progress__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Legal_Entity__c</field>
            <value>
                <elementReference>selectedNewLegalEntity.recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp_LE_Only</name>
        <label>Update Opportunity - LE Only</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reset_LE_Change_In_Progress</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>LE_Change_In_Progress__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Legal_Entity__c</field>
            <value>
                <elementReference>selectedNewLegalEntity.recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Screen_Cancelled</name>
        <label>Cancelled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Cancel_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;No Changes Made&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The Legal Entity has not been changed. Your existing Quotes are intact.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Cannot_Change_Currency</name>
        <label>Cannot Change Legal Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Cannot_Change_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(194, 57, 52);&quot;&gt;Cannot Change Legal Entity&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!formulaBlockerWarning}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Salesforce does not allow currency changes on Opportunities with related &lt;strong&gt;Products or Orders&lt;/strong&gt;. These records anchor the Opportunity currency and cannot be converted.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Options:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Go back and pick a Legal Entity that supports {!formulaOppCurrency} currency, or&lt;/li&gt;&lt;li&gt;Create a new Opportunity for the new Legal Entity.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;No changes have been made to this Opportunity.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm_Delete_Quotes</name>
        <label>Confirm Quote Deletion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Check_User_Decision</targetReference>
        </connector>
        <fields>
            <name>Warning_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(194, 57, 52);&quot;&gt;Currency Change Required&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!formulaQuoteWarning}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Salesforce does not allow currency changes on Opportunities with existing Quotes. &lt;strong&gt;All existing Quotes must be deleted&lt;/strong&gt; before the Legal Entity and currency can be changed.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;After the change, you will need to create new Quotes in the new currency.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>varUserDecision</name>
            <choiceReferences>Choice_Delete_Quotes</choiceReferences>
            <choiceReferences>Choice_Cancel</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Choose an action</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Error</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(194, 57, 52);&quot;&gt;An Error Occurred&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please contact your Salesforce Administrator if this issue persists.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Change_Needed</name>
        <label>No Change Needed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Change_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;No Change Needed&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The selected Legal Entity is the same as the current one. No changes are required.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Select_Currency</name>
        <label>Select Currency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Check_Currency_Change_Needed</targetReference>
        </connector>
        <fields>
            <name>Currency_Picker_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Select Currency&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!formulaCurrencyPickerHeader}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you pick the same currency the Opportunity already uses, only the Legal Entity will change. If you pick a different currency, the Opportunity currency will also change (Quotes will need to be deleted first).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>varSelectedCurrency</name>
            <choiceReferences>Currency_Options</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Currency</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Select_Legal_Entity</name>
        <label>Select New Legal Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_New_Legal_Entity</targetReference>
        </connector>
        <fields>
            <name>Header_Current_Info</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Change Legal Entity&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!formulaCurrentInfo}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>selectedNewLegalEntity</name>
            <extensionName>flowruntime:lookup</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>fieldApiName</name>
                <value>
                    <stringValue>Legal_Entity__c</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>New Legal Entity</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Opportunity</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>Get_Opportunity.Legal_Entity__c</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Success</name>
        <label>Legal Entity Updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Legal Entity Updated Successfully&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The Opportunity Legal Entity has been changed to &lt;strong&gt;{!Get_New_Legal_Entity.Name}&lt;/strong&gt; with currency &lt;strong&gt;{!formulaFinalCurrency}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please refresh the page to see the updated values.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <description>Opportunity Record ID passed from the Quick Action</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Null placeholder used to clear SyncedQuoteId (no default value = null at runtime)</description>
        <name>varNullId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
