    <decisions>
        <name>Pass_or_Fail</name>
        <label>Pass or Fail</label>
        <locationX>607</locationX>
        <locationY>563</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pass_TestCase</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Log_your_Test_Case_results</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Pass_Test_Case</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Log_your_Test_Case_results_FailStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Pass_Test_Case</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PASS_TC</targetReference>
            </connector>
            <label>Pass Test Case</label>
        </rules>
        <rules>
            <name>Fail_TestCase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Log_your_Test_Case_results</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Fail_Test_Case</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Fail_TC</targetReference>
            </connector>
            <label>Fail Test Case</label>
        </rules>
        <rules>
            <name>Feedback_Enhancement</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Log_your_Test_Case_results</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Feedback_Enhancement_Request</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Log_your_Test_Case_results_FailStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Feedback_Enhancement_Request</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Feedback_Submitted</targetReference>
            </connector>
            <label>Feedback/Enhancement</label>
        </rules>
    </decisions>
    <decisions>
        <name>TC_Issues_Found</name>
        <label>TC Issues Found?</label>
        <locationX>412</locationX>
        <locationY>1251</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_TC_ISSUES</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TC_Issue_Loop</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <description>7/7/2026 Copy Session to Issue
9/2/2026 Disposition required
2/2/2026 Updating picklist values api names - fix
01/20/26 Adding Dispositon to the Screenflow and setting it on the Issue record. 
09.13.23 Corrected flow to record Feedback Enhancements when TC is in failed status.  Added Help Text to Pass/Fail section.
4.17.23 Removed the defaulted text in the PASS/FAIL actual results screen.</description>
    <dynamicChoiceSets>
        <name>plcho_Disposition</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Dispositon__c</picklistField>
        <picklistObject>Test_Cases__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
