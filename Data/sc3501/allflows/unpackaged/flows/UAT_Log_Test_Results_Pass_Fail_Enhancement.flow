    <screens>
        <name>Log_Test_Results_Pass_Fail_Feedback</name>
        <label>Log Test Results Pass/Fail/Feedback</label>
        <locationX>615</locationX>
        <locationY>229</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Actual_Results</targetReference>
        </connector>
        <fields>
            <name>Pass_Fail_Help_Text</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(85, 160, 56);&quot;&gt;PASS = &lt;/strong&gt;&lt;span style=&quot;color: rgb(85, 160, 56);&quot;&gt;Everything works based on the User Story, Steps to Test and Expected Result.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(234, 16, 16);&quot;&gt;FAIL = &lt;/strong&gt;&lt;span style=&quot;color: rgb(234, 16, 16);&quot;&gt;What was tested does not match or does not work based on User Story, Steps to Test and/or Expected Result.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(6, 17, 234);&quot;&gt;FEEDBACK/ENHANCEMENT REQUEST = &lt;/strong&gt;&lt;span style=&quot;color: rgb(6, 17, 234);&quot;&gt;Suggest changes and enhancement ideas.  &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(6, 17, 234);&quot;&gt;&lt;u&gt;Note:&lt;/u&gt;&lt;/strong&gt;&lt;em style=&quot;color: rgb(6, 17, 234);&quot;&gt; &lt;/em&gt;&lt;span style=&quot;color: rgb(6, 17, 234);&quot;&gt;You will still need to &lt;/span&gt;&lt;strong style=&quot;color: rgb(6, 17, 234);&quot;&gt;Pass or Fail&lt;/strong&gt;&lt;span style=&quot;color: rgb(6, 17, 234);&quot;&gt; a test case when submitting Feedback/Enhancement Requests.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Log_your_Test_Case_results</name>
            <choiceReferences>Pass_Test_Case</choiceReferences>
            <choiceReferences>Fail_Test_Case</choiceReferences>
            <choiceReferences>Feedback_Enhancement_Request</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Log your Test Case results:</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>TestCase_Record.Status__c</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>Fail</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Log_your_Test_Case_results_FailStatus</name>
            <choiceReferences>Pass_Test_Case</choiceReferences>
            <choiceReferences>Feedback_Enhancement_Request</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Log your Test Case results</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>TestCase_Record.Status__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Fail</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
