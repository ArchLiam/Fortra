<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Decommission_Error</name>
        <label>Set Decommission Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatusUpdateSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cannot decommission hardware with active assets</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Invalid_Transition_Error</name>
        <label>Set Invalid Transition Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatusUpdateSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cannot transition from</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCurrentHardware.Status__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNewStatus</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Success</name>
        <label>Set Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatusUpdateSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Status updated successfully to</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNewStatus</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Update_Error</name>
        <label>Set Update Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatusUpdateSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Can_Decommission</name>
        <label>Can Decommission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Decommission_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Active Assets</defaultConnectorLabel>
        <rules>
            <name>No_Active_Assets</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentHardware.Primary_Asset__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply_Status_Change</targetReference>
            </connector>
            <label>No Active Assets</label>
        </rules>
    </decisions>
    <decisions>
        <name>Valid_Status_Transition</name>
        <label>Valid Status Transition?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Invalid_Transition_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Transition</defaultConnectorLabel>
        <rules>
            <name>Pending_to_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentHardware.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varNewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply_Status_Change</targetReference>
            </connector>
            <label>Pending to Active</label>
        </rules>
        <rules>
            <name>Active_to_Inactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentHardware.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varNewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply_Status_Change</targetReference>
            </connector>
            <label>Active to Inactive</label>
        </rules>
        <rules>
            <name>To_Decommissioned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Decommissioned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Can_Decommission</targetReference>
            </connector>
            <label>To Decommissioned</label>
        </rules>
    </decisions>
    <description>Manages hardware status transitions programmatically</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Hardware | Hardware Status Management Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Hardware | Hardware Status Management Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Current_Hardware</name>
        <label>Get Current Hardware</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Valid_Status_Transition</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varHardwareId</elementReference>
            </value>
        </filters>
        <object>Hardware__c</object>
        <outputReference>varCurrentHardware</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Apply_Status_Change</name>
        <label>Apply Status Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Update_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varHardwareId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Status_Change__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>varNewStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Hardware__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Current_Hardware</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varCurrentHardware</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Hardware__c</objectType>
    </variables>
    <variables>
        <description>ID of hardware to update</description>
        <name>varHardwareId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varStatusContext</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varStatusMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varStatusUpdateSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varTriggeringRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
