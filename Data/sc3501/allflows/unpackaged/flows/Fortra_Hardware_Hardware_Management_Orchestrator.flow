    <screens>
        <name>Select_Operation_Screen</name>
        <label>Select Operation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Determine_Operation_Type</targetReference>
        </connector>
        <fields>
            <name>Operation_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Hardware Management&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Select an operation to perform:&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Operation_Selection</name>
            <choiceReferences>Choice_Operation_Create</choiceReferences>
            <choiceReferences>Choice_Operation_Search</choiceReferences>
            <choiceReferences>Choice_Operation_UpdateStatus</choiceReferences>
            <dataType>String</dataType>
            <fieldText>What would you like to do?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Select_Operation_Screen</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Hardware_Creation_Subflow</name>
        <label>Hardware Creation Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Operation_Complete</targetReference>
        </connector>
        <flowName>Fortra_Hardware_Hardware_Creation_Subflow</flowName>
        <inputAssignments>
            <name>varAccountId</name>
            <value>
                <elementReference>Account_Lookup</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varHardwareName</name>
            <value>
                <elementReference>Hardware_Name_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varHardwarePlatform</name>
            <value>
                <elementReference>Hardware_Platform_Picklist</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSerialNumber</name>
            <value>
                <elementReference>Serial_Number_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varISeriesModel</name>
            <value>
                <elementReference>ISeries_Model_Picklist</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varFeatureCode</name>
            <value>
                <elementReference>Feature_Code_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varProcessors</name>
            <value>
                <elementReference>Processors_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPGroup</name>
            <value>
                <elementReference>PGroup_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varHostname</name>
            <value>
                <elementReference>Hostname_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varHardwareIdInput</name>
            <value>
                <elementReference>HardwareId_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varOperatingSystem</name>
            <value>
                <elementReference>OperatingSystem_Input</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varResultStatus</assignToReference>
            <name>varCreationStatus</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varErrorMessage</assignToReference>
            <name>varErrorMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varHardwareId</assignToReference>
            <name>varNewHardwareId</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Hardware_Status_Management_Subflow</name>
        <label>Hardware Status Management Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Operation_Complete</targetReference>
        </connector>
        <flowName>Fortra_Hardware_Hardware_Status_Management_Subflow</flowName>
        <inputAssignments>
            <name>varHardwareId</name>
            <value>
                <elementReference>varHardwareId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varNewStatus</name>
            <value>
                <elementReference>varNewStatus</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varResultStatus</assignToReference>
            <name>varStatusMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varStatusUpdateSuccess</assignToReference>
            <name>varStatusUpdateSuccess</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Search_Hardware_Subflow</name>
        <label>Search Hardware Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Search_Results</targetReference>
        </connector>
        <flowName>Fortra_Hardware_Hardware_Search_Selection_Subflow</flowName>
        <inputAssignments>
            <name>varAccountId</name>
            <value>
                <elementReference>varAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varHardwareCategory</name>
        </inputAssignments>
        <inputAssignments>
            <name>varManufacturer</name>
        </inputAssignments>
        <inputAssignments>
            <name>varModelNumber</name>
        </inputAssignments>
        <inputAssignments>
            <name>varSearchContext</name>
            <value>
                <elementReference>varContextId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSerialNumber</name>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varResultStatus</assignToReference>
            <name>varCreationStatus</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varErrorMessage</assignToReference>
            <name>varErrorMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varNewHardwareId</assignToReference>
            <name>varNewHardwareId</name>
        </outputAssignments>
    </subflows>
    <variables>
        <description>Account context</description>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Quote/Order/Asset ID</description>
        <name>varContextId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Selected/Created Hardware ID</description>
        <name>varHardwareId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Collection of found hardware records</description>
        <name>varHardwareRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Hardware__c</objectType>
    </variables>
    <variables>
        <name>varNewHardwareId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varNewStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Type of operation</description>
        <name>varOperationType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Success/Error/Warning</description>
        <name>varResultStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Pending</stringValue>
        </value>
    </variables>
    <variables>
        <name>varStatusUpdateSuccess</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
