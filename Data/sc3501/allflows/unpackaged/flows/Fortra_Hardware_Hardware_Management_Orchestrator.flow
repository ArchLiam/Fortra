    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_Search_Results</name>
        <label>Check Search Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Operation_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Single_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varResultStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SingleFound</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Operation_Complete</targetReference>
            </connector>
            <label>Single Found</label>
        </rules>
        <rules>
            <name>Multiple_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varResultStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MultipleFound</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_Hardware</targetReference>
            </connector>
            <label>Multiple Found</label>
        </rules>
        <rules>
            <name>Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varResultStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NotFound</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Operation_Complete</targetReference>
            </connector>
            <label>Not Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Operation_Type</name>
        <label>Determine Operation Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Operation</defaultConnectorLabel>
        <rules>
            <name>Search</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Operation_Selection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Search</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Search_Hardware_Subflow</targetReference>
            </connector>
            <label>Search</label>
        </rules>
        <rules>
            <name>Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Operation_Selection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Create</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Hardware_Screen</targetReference>
            </connector>
            <label>Create</label>
        </rules>
        <rules>
            <name>UpdateStatus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Operation_Selection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UpdateStatus</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hardware_Status_Management_Subflow</targetReference>
            </connector>
            <label>UpdateStatus</label>
        </rules>
    </decisions>
    <description>Master orchestration flow for all hardware operations- 
SO- No changes - Saved as most recent for deployment</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsDeleted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>varAccountId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
