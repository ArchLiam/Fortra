<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Lock_Currency_At_Order_Activation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 ISCHANGED(CurrencyIsoCode),
 OR(
     ISPICKVAL(Status, &apos;Activated&apos;),
     ISPICKVAL(Status, &apos;In Fulfillment&apos;),
     ISPICKVAL(Status, &apos;Fulfilled&apos;),
     ISPICKVAL(Status, &apos;Completed&apos;),
     ISPICKVAL(Status, &apos;Closed&apos;)
 )
)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>Currency cannot be changed after Order activation. Current status: {!Status}</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Order_BillToAddressAcct_Equal_OrderAcct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(Bill_To_Address__r.Account__c)),
 Bill_To_Address__r.Account__c !=  AccountId 
)</errorConditionFormula>
        <errorDisplayField>Bill_To_Address__c</errorDisplayField>
        <errorMessage>Select a Bill To Address that is related to this Order&apos;s Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Order_BillToContactAcct_Equal_OrderAcct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(BillToContact.AccountId)),
 BillToContact.AccountId !=  AccountId 
)</errorConditionFormula>
        <errorDisplayField>BillToContactId</errorDisplayField>
        <errorMessage>Select a Bill To Contact that is related to this Order&apos;s Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Order_BillToPlaceAcct_Equal_OrderAcct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(Bill_To_Place__r.Account__c)),
 Bill_To_Place__r.Account__c !=  AccountId 
)</errorConditionFormula>
        <errorDisplayField>Bill_To_Place__c</errorDisplayField>
        <errorMessage>Select a Bill To Place that is related to this Order&apos;s Account.</errorMessage>
    </validationRules>
</CustomObject>
