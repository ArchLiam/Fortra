<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Quote_BillToContactAcct_Equal_QuoteAcct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISBLANK(BillToContact.AccountId)),
 BillToContact.AccountId != QuoteAccountId
)</errorConditionFormula>
        <errorDisplayField>BillToContactId</errorDisplayField>
        <errorMessage>Select a Bill To Contact that is related to this Quote&apos;s Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Quote_BillToPlacceAcct_Equal_QuoteAcct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISBLANK(Bill_To_Place__r.Account__c)),
 Bill_To_Place__r.Account__c !=  QuoteAccountId 
)</errorConditionFormula>
        <errorDisplayField>Bill_To_Place__c</errorDisplayField>
        <errorMessage>Select a Bill To Place that is related to this Quote&apos;s Account.</errorMessage>
    </validationRules>
</CustomObject>
