                <valueField>$Source.QuoteAccountId</valueField>
            </filterItems>
            <infoMessage>Select a Bill To Place that is related to this Quote&apos;s Account.</infoMessage>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Places__c</referenceTo>
        <relationshipLabel>Quotes</relationshipLabel>
