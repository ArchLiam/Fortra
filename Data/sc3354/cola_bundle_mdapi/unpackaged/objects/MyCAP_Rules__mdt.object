<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configuration for MyCAP out-year uplift defaulting and Deal Desk approval thresholds on multi-year annually-billed deals</description>
    <fields>
        <fullName>Default_Out_Year_Uplift_Percent__c</fullName>
        <defaultValue>3.00</defaultValue>
        <description>Standard COLA uplift percentage applied to qualifying multi-year annually-billed QLIs when the sales rep has not overridden. Example: 3.00 for a 3% annual increase.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Default Out-Year Uplift Percent</label>
        <precision>5</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Feature toggle. When false, the MyCAP prehook branch takes no action (defaulting and approval flagging both skipped).</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Minimum_Out_Year_Uplift_Percent__c</fullName>
        <defaultValue>3.00</defaultValue>
        <description>Threshold below which Quote.Mycap__c is flagged to true (triggering Deal Desk approval via the existing record-triggered flow). Example: 3.00 means any effective uplift strictly less than 3% requires approval.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Minimum Out-Year Uplift Percent</label>
        <precision>5</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>MyCAP Rules</label>
    <pluralLabel>MyCAP Rules</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
