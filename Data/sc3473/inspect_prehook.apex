ApexClass c = [SELECT Id, Name, LengthWithoutComments, ApiVersion, Body FROM ApexClass WHERE Name='COLAUpliftPrehook'];
System.debug(LoggingLevel.ERROR, 'PREHOOK len=' + c.LengthWithoutComments + ' api=' + c.ApiVersion);
String body = c.Body;
System.debug(LoggingLevel.ERROR, 'HAS_buildNetUnitPriceUpdate=' + body.contains('buildNetUnitPriceUpdate'));
System.debug(LoggingLevel.ERROR, 'HAS_pendingNetUnitPriceUpdates=' + body.contains('pendingNetUnitPriceUpdates'));
System.debug(LoggingLevel.ERROR, 'HAS_NetUnitPrice_str=' + body.contains('NetUnitPrice'));
System.debug(LoggingLevel.ERROR, 'HAS_SC3350=' + body.contains('SC-3350') + ' HAS_SC3354=' + body.contains('SC-3354'));
Integer idx = body.indexOf('@version');
if (idx>=0) System.debug(LoggingLevel.ERROR, 'VERSION_LINE=' + body.substring(idx, Math.min(idx+40, body.length())));
Integer ni = body.indexOf('buildNetUnitPriceUpdate');
if (ni>=0) System.debug(LoggingLevel.ERROR, 'NET_CTX=' + body.substring(Math.max(0,ni-200), Math.min(ni+400, body.length())));
