<ul local-id=3D"9753f9ca206a">
<li local-id=3D"7d172a24d3ae">
<p local-id=3D"cf5aa84cf5e5">Based on Rev Category Selected - Default the f=
ollowing fields<br></p></li>
</ul>
<div class=3D"table-wrap">
<table data-table-width=3D"1593" data-layout=3D"center" data-local-id=3D"18=
b0f44f-f990-46ab-b2cc-5ee1f0844136" class=3D"confluenceTable">
<tbody>
<tr data-local-id=3D"5113569c-a975-4a08-ba00-c158aa3b26da">
<td data-local-id=3D"59044c7c-a524-413b-8211-8b7550ca91e2" class=3D"conflue=
nceTd">
<p local-id=3D"c5c03e02c031">Revenue Category</p></td>
<td data-local-id=3D"45e19906-7ad2-40a6-a865-bac4cc288728" class=3D"conflue=
nceTd">
<p local-id=3D"d9e50b0944cd">Product Identifier</p></td>
<td data-local-id=3D"6d71311f-3f3e-4cd8-b6c4-27fd5ac4a368" class=3D"conflue=
nceTd">
<p local-id=3D"3a8ec9d6b707">Revenue Category Name</p></td>
<td data-local-id=3D"eef3b386-2047-4d88-a1b7-2684b0d204c1" class=3D"conflue=
nceTd">
<p local-id=3D"d0a81eea450d">Revenue Recognition Schedule Template</p></td>
<td data-local-id=3D"9cada5f0-6e01-48b0-81b6-5938fec164c0" class=3D"conflue=
nceTd">
<p local-id=3D"f9fc6ed8bc29">Revenue Treatment</p></td>
<td data-local-id=3D"ccc6ff74-d396-419f-81c3-a7852f542ad0" class=3D"conflue=
