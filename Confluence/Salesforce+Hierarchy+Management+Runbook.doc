<td data-local-id=3D"661350f8704b" class=3D"confluenceTd">
<p local-id=3D"a5b6eb5a92ec">Category choices are manually defined in the f=
low</p></td>
</tr>
<tr data-local-id=3D"3bd80abd5a4e">
<td data-local-id=3D"aeb26c3760ba" class=3D"confluenceTd">
