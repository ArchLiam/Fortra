<td data-local-id=3D"f32f1561d7dd" class=3D"confluenceTd">
<p local-id=3D"2c03dfe41008">Picklist</p></td>
<td data-local-id=3D"2a13d18556e2" class=3D"confluenceTd">
<p local-id=3D"da3db69f4ff6">Shared value set Unit; update in Setup -&gt; P=
icklist Value Sets -&gt; Unit</p></td>
</tr>
<tr data-local-id=3D"82721a6daff3">
<td data-local-id=3D"265c8c4f44b1" class=3D"confluenceTd">
<p local-id=3D"6aee77b560a7">Lead</p></td>
