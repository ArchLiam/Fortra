 COLA_Uplift_Rules__mdt.Solution_Category__c and writes QuoteLineItem.COLA_=
Solution_Category__c</p></td>
</tr>
<tr data-local-id=3D"20a733af66c9">
<td data-local-id=3D"a742cb1de4e9" class=3D"confluenceTd">
<p local-id=3D"4c245d3d39ec">RCATechnicalProductService</p></td>
<td data-local-id=3D"a67bac9b7889" class=3D"confluenceTd">
