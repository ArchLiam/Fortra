<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UOM_Required_For_Active_Products</fullName>
    <active>true</active>
    <errorConditionFormula>AND(IsActive, ISBLANK(TEXT(QuantityUnitOfMeasure)))</errorConditionFormula>
    <errorMessage>Active products must have a Unit of Measure</errorMessage>
</ValidationRule>
