    <formulas>
        <name>normalizedFromNumberFormula</name>
        <dataType>String</dataType>
        <expression>RIGHT(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE({!$Record.FromPhoneNumber}, &quot; &quot;, &quot;&quot;),
&quot;-&quot;, &quot;&quot;),
&quot;(&quot;, &quot;&quot;),
&quot;)&quot;, &quot;&quot;),
&quot;+&quot;, &quot;&quot;),
10)</expression>
    </formulas>
    <formulas>
        <name>normalizedToNumberFormula</name>
        <dataType>String</dataType>
        <expression>RIGHT(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE(
SUBSTITUTE({!$Record.ToPhoneNumber}, &quot; &quot;, &quot;&quot;),
&quot;-&quot;, &quot;&quot;),
&quot;(&quot;, &quot;&quot;),
&quot;)&quot;, &quot;&quot;),
&quot;+&quot;, &quot;&quot;),
10)</expression>
    </formulas>
    <formulas>
        <name>PhoneNumberToEvaluate</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!$Record.CallType}, &quot;Inbound&quot;),
    {!$Record.FromPhoneNumber},
    {!$Record.ToPhoneNumber}
)</expression>
    </formulas>
    <formulas>
        <name>regionByPhoneCountryCode</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1242&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1246&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1264&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1268&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1473&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1658&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1758&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1767&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1809&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1829&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1849&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+1876&quot;)
    ),
    &quot;LATAM&quot;,

IF(
    BEGINS({!PhoneNumberToEvaluate}, &quot;+1&quot;),
    &quot;NORAM&quot;,

IF(
    OR(
        BEGINS({!PhoneNumberToEvaluate}, &quot;+2&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+3&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+4&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+7&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+90&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+96&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+97&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+98&quot;)
    ),
    &quot;EMEA&quot;,

IF(
    OR(
        BEGINS({!PhoneNumberToEvaluate}, &quot;+6&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+8&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+91&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+92&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+93&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+94&quot;),
        BEGINS({!PhoneNumberToEvaluate}, &quot;+95&quot;)
    ),
    &quot;APAC&quot;,

&quot;Other&quot;
))))</expression>
    </formulas>
