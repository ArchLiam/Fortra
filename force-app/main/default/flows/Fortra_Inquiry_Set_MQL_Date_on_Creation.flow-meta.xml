<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>SC-2421 Entry Criteria</description>
    <environments>Default</environments>
    <formulas>
        <name>Current_Time_Stamp</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Fortra - Inquiry - Set MQL Date on Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra - Inquiry - Set MQL Date on Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_MQL_Date</name>
        <label>Update MQL Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>MQL_Date__c</field>
            <value>
                <elementReference>Current_Time_Stamp</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_MQL_Date</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.Actionable__c} = TRUE,

    ISCHANGED({!$Record.Status}),
    ISPICKVAL({!$Record.Status}, &quot;Assigned&quot;),
   
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Sales-Inbound&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Sales-Outbound&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Cross Sell&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Customer Referral&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Deal Registration&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;HelpSell&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;In-App&quot;)),
    NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Services&quot;)),
    
    ISBLANK({!$Record.MQL_Date__c})
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
