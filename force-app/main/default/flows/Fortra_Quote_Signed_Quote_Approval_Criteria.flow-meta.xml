    <decisions>
        <name>Is_Quote_Signed</name>
        <label>Is Quote Signed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.Signed_Quote__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Signed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_Tier_is_Subtotal_in</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Tier_is_Subtotal_in</name>
        <label>What Tier is Subtotal in?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Submission_Screen_100k</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Greater Than 100k</defaultConnectorLabel>
        <rules>
            <name>Under_15k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.GrandTotal</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>15000.0</numberValue>
                </rightValue>
            </conditions>
            <label>Under 15k</label>
        </rules>
        <rules>
            <name>X15k_25k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.GrandTotal</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>15000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_record.GrandTotal</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_Screen_15k_25k</targetReference>
            </connector>
            <label>15k - 25k</label>
        </rules>
        <rules>
            <name>X25k_100k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_record.GrandTotal</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_record.GrandTotal</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_Screen_25k_100k</targetReference>
            </connector>
            <label>25k - 100k</label>
        </rules>
    </decisions>
