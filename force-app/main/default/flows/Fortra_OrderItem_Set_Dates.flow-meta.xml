<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Is_Termed_Blank</name>
        <label>Is Termed Line Missing Term Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Perpetual</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Termed_Needs_Dates</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProductSellingModel.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TermDefined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PricingTermCount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Backstop_Std_Term_Fields</targetReference>
            </connector>
            <label>Termed - Needs Dates</label>
        </rules>
    </decisions>
    <decisions>
        <name>Perpetual</name>
        <label>Perpetual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Non_Perpetual_Set_Dates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non Perpetual</defaultConnectorLabel>
        <rules>
            <name>Perpetual_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product2.Rev_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RC_41000</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Perpetual_Set_Dates</targetReference>
            </connector>
            <label>Perpetual</label>
        </rules>
    </decisions>
    <description>2026-06-15: Stamp standard EndDate/PricingTermCount on blank termed lines so they pass activation
2026-06-05: Default non-perpetual billing From/To Dates to a 12-month term off the order effective date when line dates are blank</description>
    <environments>Default</environments>
    <formulas>
        <name>Calculated_From_Date</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.ServiceDate})), {!$Record.ServiceDate}, {!$Record.Order.EffectiveDate})</expression>
    </formulas>
    <formulas>
        <name>Calculated_To_Date</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.EndDate})), {!$Record.EndDate},
ADDMONTHS(IF(NOT(ISBLANK({!$Record.ServiceDate})), {!$Record.ServiceDate}, {!$Record.Order.EffectiveDate}), 12) - 1)</expression>
    </formulas>
    <formulas>
        <name>Std_PricingTermCount</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.PricingTermCount}), 1, {!$Record.PricingTermCount})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Fortra | OrderItem | Set Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | OrderItem | Set Dates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Backstop_Std_Term_Fields</name>
        <label>Backstop Standard Term Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Perpetual</targetReference>
        </connector>
        <inputAssignments>
            <field>EndDate</field>
            <value>
                <elementReference>Calculated_To_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PricingTermCount</field>
            <value>
                <elementReference>Std_PricingTermCount</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Non_Perpetual_Set_Dates</name>
        <label>Non Perpetual - Set Dates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Billing_Schedule_From_Date__c</field>
            <value>
                <elementReference>Calculated_From_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billing_Schedule_To_Date__c</field>
            <value>
                <elementReference>Calculated_To_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Date_Calculated__c</field>
            <value>
                <elementReference>Calculated_To_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Start_Date_Calculated__c</field>
            <value>
                <elementReference>Calculated_From_Date</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
