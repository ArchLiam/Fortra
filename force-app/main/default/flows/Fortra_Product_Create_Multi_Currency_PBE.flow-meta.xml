        <dataType>Currency</dataType>
        <expression>{!varUnitPrice} * VALUE(TRIM(SUBSTITUTE({!curFormula.Conversion_Formula__c}, &quot;*&quot;, &quot;&quot;)))</expression>
        <scale>2</scale>
    </formulas>
