        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Contact_Email_Populated_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Domain_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>userContactDomain</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record.Contact.Email}),
    &quot;&quot;, 
    RIGHT({!$Record.Contact.Email}, LEN({!$Record.Contact.Email}) - FIND(&quot;@&quot;, {!$Record.Email}))
)</expression>
    </formulas>
