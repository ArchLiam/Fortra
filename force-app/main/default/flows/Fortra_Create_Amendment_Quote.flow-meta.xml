    <description>Override for quotingAI__createAmendmentQuote. Resolves Asset origin chain, creates Opportunity, calls initiateAmendment with pre-resolved OpportunityId and ContractId, then populates Fortra-specific fields including Quote_Type__c=Amendment and default Amendment_Reason__c=Upsell.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_AmendStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!amendmentDate}) &amp; &quot;T00:00:00.000Z&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_BillingCity</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingCity}), {!Get_Account.BillingCity}, {!Get_Original_Quote.BillingCity})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingCountry</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingCountry}), {!Get_Account.BillingCountry}, {!Get_Original_Quote.BillingCountry})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingPostalCode</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingPostalCode}), {!Get_Account.BillingPostalCode}, {!Get_Original_Quote.BillingPostalCode})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingState</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingState}), {!Get_Account.BillingState}, {!Get_Original_Quote.BillingState})</expression>
    </formulas>
    <formulas>
        <name>formula_BillingStreet</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Original_Quote.BillingStreet}), {!Get_Account.BillingStreet}, {!Get_Original_Quote.BillingStreet})</expression>
    </formulas>
    <formulas>
        <name>formula_CloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Contract.EndDate}), TODAY() + 90, {!Get_Contract.EndDate})</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityName</name>
        <dataType>String</dataType>
        <expression>&quot;Amendment - &quot; &amp; {!Get_Account.Name} &amp; &quot; - &quot; &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>formula_TransformedDealOrigin</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!Get_Original_Opportunity.Deal_Origin__c})),
    &quot;&quot;,
    IF(
        TEXT({!Get_Original_Opportunity.Deal_Origin__c}) = &quot;Fortra Originated&quot;,
        &quot;Fortra Originated&quot;,
        &quot;Channel Originated&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TransformedDealType</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!Get_Original_Quote.Deal_Type__c})),
    &quot;&quot;,
    IF(
        TEXT({!Get_Original_Quote.Deal_Type__c}) = &quot;Fortra Originated&quot;,
        &quot;Fortra Originated&quot;,
        &quot;Channel Originated&quot;
    )
)</expression>
    </formulas>
