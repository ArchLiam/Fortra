    <assignments>
        <name>Assign_Quote_Count</name>
        <label>Assign Quote Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQuoteCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_All_Quotes_For_Opportunity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Subtract_Deleted_Quote</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Subtract_Deleted_Quote</name>
        <label>Subtract Deleted Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQuoteCount</assignToReference>
            <operator>Subtract</operator>
            <value>
