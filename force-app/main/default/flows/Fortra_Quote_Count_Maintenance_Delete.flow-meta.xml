            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Quote_Count</targetReference>
        </connector>
    </assignments>
    <description>Maintains the Quote_Count__c field on Opportunity by recounting related Quotes before a Quote is deleted. Companion to Fortra_Quote_Count_Maintenance (Create trigger). Subtracts 1 from the count because the Before Delete context still includes the record being deleted in query results.</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Quote | Count Maintenance - Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Quote | Count Maintenance - Delete</label>
