<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_currencyIsValid_to_True</name>
        <label>Set currencyIsValid to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_CurrencyIsValid</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Mdt_is_Primary</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_PrimaryCurrency</name>
        <label>Set PrimaryCurrency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_PrimaryCurrency</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Custom_Mdt_Records.Currency_Code__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Custom_Mdt_Records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Currency_Valid_or_Not</name>
        <label>Currency Valid or Not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome(Currency Not Valid)</defaultConnectorLabel>
        <rules>
            <name>Currency_Is_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_CurrencyIsValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Currency Is Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Mdt_is_Primary</name>
        <label>Mdt is Primary?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Custom_Mdt_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome(NO)</defaultConnectorLabel>
        <rules>
            <name>Primary</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Custom_Mdt_Records.Is_Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_PrimaryCurrency</targetReference>
            </connector>
            <label>Primary</label>
        </rules>
    </decisions>
    <decisions>
        <name>Mdt_matches_Opportunity_Currency</name>
        <label>Mdt matches Opportunity Currency?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mdt_is_Primary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome(NO)</defaultConnectorLabel>
        <rules>
            <name>Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Custom_Mdt_Records.Currency_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.CurrencyIsoCode</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_currencyIsValid_to_True</targetReference>
            </connector>
            <label>Matches</label>
        </rules>
    </decisions>
    <description>Before-save flow that validates the Legal Entity + Currency combination against Legal_Entity_Currency__mdt when Legal Entity changes. If the current currency is not valid for the new LE, sets currency to the LE&apos;s primary currency from CMDT.</description>
    <environments>Default</environments>
    <interviewLabel>Fortra | Opportunity | LE Currency Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Opportunity | LE Currency Validation</label>
    <loops>
        <name>Loop_Custom_Mdt_Records</name>
        <label>Loop Custom Mdt Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>var_CMDT_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Mdt_matches_Opportunity_Currency</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Currency_Valid_or_Not</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Legal_Entities_Mdt</name>
        <label>Legal Entities Mdt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Custom_Mdt_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Legal_Entity_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Legal_Entity__r.Name</elementReference>
            </value>
        </filters>
        <object>Legal_Entity_Currency__mdt</object>
        <outputReference>var_CMDT_Records</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Is_Primary__c</queriedFields>
        <queriedFields>Currency_Code__c</queriedFields>
        <queriedFields>Legal_Entity_Name__c</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>var_PrimaryCurrency</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Legal_Entities_Mdt</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Legal_Entity__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Legal_Entity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_CMDT_Records</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Legal_Entity_Currency__mdt</objectType>
    </variables>
    <variables>
        <name>var_CurrencyIsValid</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_PrimaryCurrency</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
