    <environments>Default</environments>
    <formulas>
        <name>forCalculateARR</name>
        <dataType>Currency</dataType>
        <expression>IF(
  OR(
    TEXT({!Loop_Through_Line_Items.ProductSellingModel.SellingModelType}) = &quot;Term-Defined&quot;,
   TEXT({!Loop_Through_Line_Items.ProductSellingModel.SellingModelType}) = &quot;Evergreen&quot;
  ),
  ({!Loop_Through_Line_Items.NetUnitPrice} * {!Loop_Through_Line_Items.Quantity} * 12) / 
  IF(
    ISBLANK({!Loop_Through_Line_Items.SubscriptionTerm}), 
    12, 
    ({!Loop_Through_Line_Items.SubscriptionTerm} * 12)
  ),
  0
)</expression>
        <scale>2</scale>
    </formulas>
