<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Send_warning_for_mismatched_opportunity_and_quote_currencies</name>
        <label>Send warning for mismatched opportunity and quote currencies</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Warning: The Opportunity currency does not match the Quote&apos;s currency!</errorMessage>
            <fieldSelection>CurrencyIsoCode</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Does_Opportunity_currency_match_Quote_currency</name>
        <label>Does Opportunity currency match Quote currency?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_warning_for_mismatched_opportunity_and_quote_currencies</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Does Not Match</defaultConnectorLabel>
        <rules>
            <name>Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrencyIsoCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Original_Opportunity_Currency__c</elementReference>
                </rightValue>
            </conditions>
            <label>Match</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Warn_Oportunity_Quote_Currency_Mismatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Warn_Opportunity_Quote_Currency_Mismatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Original_Opportunity_Currency</name>
        <label>Update Original Opportunity Currency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Does_Opportunity_currency_match_Quote_currency</targetReference>
        </connector>
        <inputAssignments>
            <field>Original_Opportunity_Currency__c</field>
            <value>
                <elementReference>$Record.Opportunity.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Original_Opportunity_Currency</targetReference>
        </connector>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
