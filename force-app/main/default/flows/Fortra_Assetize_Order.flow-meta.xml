    <apiVersion>67.0</apiVersion>
    <assignments>
        <description>Captures the fault message so the flow ends gracefully instead of throwing an unhandled exception. The error is still logged in Salesforce debug logs.</description>
        <name>Assign_Error_Message</name>
        <label>Capture Error (Graceful End)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Stamp_Assetization_Failed</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Determines whether GetApplicationUsageAssignment returned an application usage assignment record.</description>
        <name>HaveApplicationUsageAssignmentRecord</name>
        <label>Have Application Usage Assignment Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No (Default)</defaultConnectorLabel>
        <rules>
            <name>HaveRecord</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AppUsageAssignment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Finalize_Order_Commercial_Net</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>SC-3415: on a successful asset run, only clear Order_Integration_Error_Messages__c if it currently holds an assetization message — never clobber other integration errors.</description>
        <name>Prior_Assetization_Error</name>
        <label>Prior Assetization Error?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_Assetization_Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Order_Integration_Error_Messages__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Assetization failed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Assetization_Error</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>SC-3415: prefixed fault message written to the Order&apos;s existing integration-error field.</description>
        <name>faultText</name>
        <dataType>String</dataType>
        <expression>&quot;Assetization failed: &quot; &amp; {!varErrorMessage}</expression>
    </formulas>
    <interviewLabel>Fortra - Assetize Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra - Assetize Order</label>
    <overriddenFlow>revenue_o2aflows__o2aFlow</overriddenFlow>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the application usage assignment element with a record ID of the order ID of the triggering record and an app usage type that&apos;s RevenueLifecycleManagement. Stores the ID field of the result in the AppUsageAssignment record variable.</description>
        <name>GetApplicationUsageAssignment</name>
        <label>Get ApplicationUsageAssignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveApplicationUsageAssignmentRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AppUsageType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RevenueLifecycleManagement</stringValue>
            </value>
        </filters>
        <object>AppUsageAssignment</object>
        <outputReference>AppUsageAssignment</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>SC-3415: clears a prior assetization failure message after a successful run.</description>
        <name>Clear_Assetization_Error</name>
        <label>Clear Assetization Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Order_Integration_Error_Messages__c</field>
            <value>
                <elementReference>varBlank</elementReference>
            </value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <recordUpdates>
        <description>SC-3415: surfaces a failed async asset-generation run on the Order&apos;s existing integration-error field instead of swallowing it silently. Writes only that field, never Status, so it cannot re-trigger this flow.</description>
        <name>Stamp_Assetization_Failed</name>
        <label>Stamp Assetization Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Order_Integration_Error_Messages__c</field>
            <value>
                <elementReference>faultText</elementReference>
            </value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
