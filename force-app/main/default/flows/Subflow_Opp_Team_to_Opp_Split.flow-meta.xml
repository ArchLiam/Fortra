<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_User_to_List</name>
        <label>Add User to List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>opportunitySplitsUserList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Opportunity_Splits.SplitOwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opportunity_Splits</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Final_Percent_to_Uneven_Percentage</name>
        <label>Set Final Percent to Uneven Percentage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>opportunitySplitPercent_Final</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>opportunitySplitPercentUneven</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Split_Already_Exists_for_OTM_Decision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Loop_Count</name>
        <label>Set Loop Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>otmLoopCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_OTMs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_New_Opportunity_Split</name>
        <label>Set New Opportunity Split</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TEMP_OpportunitySplit.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>opportunity_Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TEMP_OpportunitySplit.SplitOwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OTMs.UserId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TEMP_OpportunitySplit.SplitPercentage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>opportunitySplitPercent_Final</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>oppSplitsToUpsert</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TEMP_OpportunitySplit</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Loop_Count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Opportunity_Team_Count</name>
        <label>Set Opportunity Team Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>opportunityTeamCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_All_Opportunity_Team_Members</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_OTMs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Existing_Opportunity_Split</name>
        <label>Update Existing Opportunity Split</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Single_Opportunity_Split.SplitPercentage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>opportunitySplitPercent_Final</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>oppSplitsToUpsert</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Single_Opportunity_Split</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Single_Opportunity_Split</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Opportunity_Splits</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Opportunity Splits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Opportunity_Splits</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_All_Opportunity_Splits</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Opportunity_Splits.SplitOwnerId</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_OTMs.UserId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Single_Opportunity_Split</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Opportunity_Splits_to_Upsert_Decision</name>
        <label>Opportunity Splits to Upsert?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Opportunity_Splits_to_Insert_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oppSplitsToUpsert</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Upsert_Opportunity_Splits</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Set_Uneven_Split_Percent_Decision</name>
        <label>Set Uneven Split Percent?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Split_Already_Exists_for_OTM_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Set_Uneven_Split_Percent_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>splitIsUneven</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>otmLoopCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>opportunityTeamCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Final_Percent_to_Uneven_Percentage</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Split_Already_Exists_for_OTM_Decision</name>
        <label>Split Already Exists for OTM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_New_Opportunity_Split</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Split_Already_Exists_for_OTM_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>opportunitySplitsUserList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_OTMs.UserId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Opportunity_Splits</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_List_Contains_Current_User_Decision</name>
        <label>User List Contains Current User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_User_to_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_User_List_Contains_Current_User_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>opportunitySplitsUserList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Opportunity_Splits.SplitOwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Opportunity_Splits</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>opportunitySplitPercentEven</name>
        <dataType>Number</dataType>
        <expression>100 / {!opportunityTeamCount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>opportunitySplitPercentUneven</name>
        <dataType>Number</dataType>
        <expression>100 - ({!opportunityTeamCount} - 1) * {!opportunitySplitPercentEven}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>splitIsUneven</name>
        <dataType>Boolean</dataType>
        <expression>IF(MOD(100,{!opportunityTeamCount}) = 0, false, true)</expression>
    </formulas>
    <interviewLabel>Subflow | Opp Team to Opp Split {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Subflow - Opportunity Team to Opportunity Split</label>
    <loops>
        <name>Loop_Opportunity_Splits</name>
        <label>Loop Opportunity Splits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Opportunity_Splits</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>User_List_Contains_Current_User_Decision</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_All_Opportunity_Team_Members</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_OTMs</name>
        <label>Loop OTMs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Opportunity_Team_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Uneven_Split_Percent_Decision</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Opportunity_Splits_to_Upsert_Decision</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Single_Opportunity_Split</name>
        <label>Loop Single Opportunity Split</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_Opportunity_Splits</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Existing_Opportunity_Split</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Loop_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Upsert_Opportunity_Splits</name>
        <label>Upsert Opportunity Splits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesUpsert>true</doesUpsert>
        <inputReference>oppSplitsToUpsert</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_All_Opportunity_Splits</name>
        <label>Get All Opportunity Splits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Opportunity_Splits</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>opportunity_Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunitySplit</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_All_Opportunity_Team_Members</name>
        <label>Get All Opportunity Team Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Opportunity_Team_Count</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>opportunity_Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account Executive</stringValue>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity Owner</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityTeamMember</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Opportunity_Splits</targetReference>
        </connector>
    </start>
    <status>Active</status>
