            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getProductPreview.success</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
