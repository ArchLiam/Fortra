<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Data_Migration_User_Decision</name>
        <label>Data Migration User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Data_Migration_User_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dataMigrationUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>HS_Contact_Upsert_Platform_Event</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>2026-05-15: Data Migration bypass
2026-02-27: Switching to upsert platform event
2026-02-18 Flow Label
2026-01-07: Removing WD Events per Permender/Jeff</description>
    <environments>Default</environments>
    <formulas>
        <name>dataMigrationUser</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    OR(
        {!$User.Username} = &apos;data.migration@coastalcloud.us.db2&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.uat&apos;,
        {!$User.Username} = &apos;data.migration@coastalcloud.us.fortraprod&apos;
    ),
    TRUE,
    FALSE
)</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Contact | After Insert/Update - Platform Events {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fortra | Contact | After Insert/Update - Platform Events</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>HS_Contact_Upsert_Platform_Event</name>
        <label>HS Contact Upsert Platform Event</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Contact_Id__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Contact_Upsert_HS__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Data_Migration_User_Decision</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>HS_Sync_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
